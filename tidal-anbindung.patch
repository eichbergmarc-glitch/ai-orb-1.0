--- /dev/null
+++ b/backend/integrations/tidal/client.py
@@ -0,0 +1,318 @@
+"""Der TIDAL-Client.
+
+Spricht die offizielle TIDAL-API (``https://openapi.tidal.com/v2``) an. Sie
+folgt dem JSON:API-Format: Antworten haben ``data`` (die Treffer als
+``{id, type}``) und ``included`` (die eigentlichen Angaben zu Titeln und
+Künstlern). Wie beim Kalender nur mit der stdlib und einem einschleusbaren
+Transport, damit kein Test echte Playlists anlegt.
+
+## Abspielen
+
+Die öffentliche API liefert keine Musik aus - abgespielt wird in der
+TIDAL-App. Der Orb sucht den Titel über die API und öffnet ihn dann mit
+einem ``tidal://``-Link in der App (ersatzweise im Browser auf tidal.com).
+Gesteuert (Pause, weiter, lauter) wird über die Medientasten von Windows,
+auf die die TIDAL-App hört.
+"""
+
+from __future__ import annotations
+
+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass, field
+from typing import Any, Protocol
+
+from backend.integrations.tidal.oauth import TidalAuth, TidalAuthFehler
+from backend.system.logging_setup import get_logger
+
+logger = get_logger(__name__)
+
+API_BASE = "https://openapi.tidal.com/v2"
+_JSONAPI = "application/vnd.api+json"
+
+#: Wie viele Titel TIDAL pro Anfrage zu einer Playlist hinzufügen lässt.
+_HINZUFUEGEN_PRO_ANFRAGE = 20
+
+
+class TidalFehler(RuntimeError):
+    """Ein Fehler beim Zugriff auf TIDAL."""
+
+
+class Transport(Protocol):
+    def request(
+        self, method: str, url: str, *, token: str, body: dict[str, Any] | None
+    ) -> dict[str, Any]:
+        ...
+
+
+class UrllibTransport:
+    """Der echte Transport über ``urllib``."""
+
+    def request(
+        self, method: str, url: str, *, token: str, body: dict[str, Any] | None
+    ) -> dict[str, Any]:
+        daten = json.dumps(body).encode("utf-8") if body is not None else None
+        kopf = {"Authorization": f"Bearer {token}", "Accept": _JSONAPI}
+        if daten is not None:
+            kopf["Content-Type"] = _JSONAPI
+        anfrage = urllib.request.Request(url, data=daten, headers=kopf, method=method)
+        try:
+            with urllib.request.urlopen(anfrage, timeout=30) as antwort:
+                roh = antwort.read().decode("utf-8")
+                return json.loads(roh) if roh.strip() else {}
+        except urllib.error.HTTPError as fehler:
+            text = fehler.read().decode("utf-8", errors="replace")[:400]
+            if fehler.code == 401:
+                raise TidalFehler(
+                    "TIDAL hat die Anmeldung nicht akzeptiert. Sag „Melde mich "
+                    f"bei TIDAL an“. ({text})"
+                ) from fehler
+            if fehler.code == 403:
+                raise TidalFehler(
+                    "TIDAL verweigert das. Meist fehlt in der Anwendung im "
+                    "Entwicklerportal ein Bereich (Scope) oder die Anmeldung "
+                    f"stammt von vor der Änderung. ({text})"
+                ) from fehler
+            if fehler.code == 404:
+                raise TidalFehler("Das gibt es bei TIDAL nicht (mehr).") from fehler
+            if fehler.code == 429:
+                raise TidalFehler("TIDAL bremst gerade - zu viele Anfragen. Gleich noch einmal.") from fehler
+            raise TidalFehler(f"TIDAL antwortete mit {fehler.code}: {text}") from fehler
+        except (urllib.error.URLError, TimeoutError, OSError) as fehler:
+            raise TidalFehler(f"TIDAL ist nicht erreichbar: {fehler}") from fehler
+
+
+@dataclass(slots=True)
+class Titel:
+    id: str
+    name: str = ""
+    kuenstler: list[str] = field(default_factory=list)
+    dauer: str = ""
+
+    def zum_vorlesen(self) -> str:
+        if self.kuenstler:
+            return f"„{self.name}“ von {', '.join(self.kuenstler)}"
+        return f"„{self.name}“"
+
+    @property
+    def link(self) -> str:
+        return f"https://tidal.com/browse/track/{self.id}"
+
+    @property
+    def app_link(self) -> str:
+        return f"tidal://track/{self.id}"
+
+
+@dataclass(slots=True)
+class Playlist:
+    id: str
+    name: str = ""
+    anzahl: int | None = None
+
+    @property
+    def link(self) -> str:
+        return f"https://tidal.com/browse/playlist/{self.id}"
+
+    @property
+    def app_link(self) -> str:
+        return f"tidal://playlist/{self.id}"
+
+
+def _dauer_lesen(iso: str) -> str:
+    """``PT3M25S`` -> ``3:25``."""
+
+    import re
+
+    treffer = re.fullmatch(r"PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?", iso or "")
+    if not treffer:
+        return ""
+    h, m, s = (int(x or 0) for x in treffer.groups())
+    m += h * 60
+    return f"{m}:{s:02d}"
+
+
+class TidalClient:
+    """Suchen, Playlists anlegen und füllen."""
+
+    def __init__(
+        self,
+        auth: TidalAuth,
+        *,
+        land: str = "CH",
+        transport: Transport | None = None,
+    ) -> None:
+        self.auth = auth
+        self.land = (land or "CH").upper()
+        self._transport = transport or UrllibTransport()
+
+    # --- intern ----------------------------------------------------------------
+
+    def _url(self, pfad: str, params: dict[str, Any] | None = None) -> str:
+        alle = {"countryCode": self.land, **(params or {})}
+        return f"{API_BASE}{pfad}?{urllib.parse.urlencode(alle, safe=',[]')}"
+
+    def _anfrage(
+        self,
+        method: str,
+        pfad: str,
+        *,
+        params: dict[str, Any] | None = None,
+        body: dict[str, Any] | None = None,
+        benutzer: bool = False,
+    ) -> dict[str, Any]:
+        try:
+            token = self.auth.user_token() if benutzer else self.auth.bester_token()
+        except TidalAuthFehler as fehler:
+            raise TidalFehler(str(fehler)) from fehler
+        return self._transport.request(method, self._url(pfad, params), token=token, body=body)
+
+    @staticmethod
+    def _titel_aus(dokument: dict[str, Any], reihenfolge: list[str]) -> list[Titel]:
+        """Setzt Titel und Künstlernamen aus ``data`` und ``included`` zusammen."""
+
+        eintraege = list(dokument.get("included") or [])
+        daten = dokument.get("data")
+        if isinstance(daten, list):
+            eintraege += [d for d in daten if d.get("attributes")]
+        elif isinstance(daten, dict) and daten.get("attributes"):
+            eintraege.append(daten)
+
+        kuenstler = {
+            e["id"]: str(e.get("attributes", {}).get("name", ""))
+            for e in eintraege
+            if e.get("type") == "artists"
+        }
+        titel: dict[str, Titel] = {}
+        for e in eintraege:
+            if e.get("type") != "tracks":
+                continue
+            attr = e.get("attributes") or {}
+            name = str(attr.get("title", ""))
+            if attr.get("version"):
+                name += f" ({attr['version']})"
+            namen = [
+                kuenstler[r["id"]]
+                for r in ((e.get("relationships") or {}).get("artists") or {}).get("data") or []
+                if r.get("id") in kuenstler and kuenstler[r["id"]]
+            ]
+            titel[str(e["id"])] = Titel(
+                id=str(e["id"]),
+                name=name,
+                kuenstler=namen,
+                dauer=_dauer_lesen(str(attr.get("duration", ""))),
+            )
+        return [titel[i] for i in reihenfolge if i in titel]
+
+    # --- Suche -----------------------------------------------------------------
+
+    def suchen(self, text: str, *, anzahl: int = 5) -> list[Titel]:
+        """Sucht Titel im Katalog."""
+
+        begriff = (text or "").strip()
+        if not begriff:
+            return []
+        antwort = self._anfrage(
+            "GET",
+            f"/searchResults/{urllib.parse.quote(begriff, safe='')}/relationships/tracks",
+            params={"include": "tracks"},
+        )
+        ids = [str(d.get("id")) for d in (antwort.get("data") or []) if d.get("type") == "tracks"]
+        ids = ids[: max(1, anzahl)]
+        if not ids:
+            return []
+        return self.titel_holen(ids)
+
+    def titel_holen(self, ids: list[str]) -> list[Titel]:
+        """Holt Titel samt Künstlernamen."""
+
+        if not ids:
+            return []
+        antwort = self._anfrage(
+            "GET",
+            "/tracks",
+            params={"filter[id]": ",".join(ids), "include": "artists"},
+        )
+        titel = self._titel_aus(antwort, ids)
+        # Wenn TIDAL Künstler nicht mitliefert, sind die Titel trotzdem brauchbar.
+        bekannt = {t.id for t in titel}
+        return titel + [Titel(id=i) for i in ids if i not in bekannt]
+
+    # --- Playlists -------------------------------------------------------------
+
+    def playlist_anlegen(self, name: str, *, beschreibung: str = "", oeffentlich: bool = False) -> Playlist:
+        antwort = self._anfrage(
+            "POST",
+            "/playlists",
+            body={
+                "data": {
+                    "type": "playlists",
+                    "attributes": {
+                        "name": name,
+                        "description": beschreibung,
+                        "accessType": "PUBLIC" if oeffentlich else "UNLISTED",
+                    },
+                }
+            },
+            benutzer=True,
+        )
+        daten = antwort.get("data") or {}
+        if not daten.get("id"):
+            raise TidalFehler("TIDAL hat die Playlist nicht bestätigt.")
+        return Playlist(id=str(daten["id"]), name=str((daten.get("attributes") or {}).get("name", name)), anzahl=0)
+
+    def titel_hinzufuegen(self, playlist_id: str, titel_ids: list[str]) -> int:
+        """Hängt Titel an eine Playlist an. Gibt die Anzahl zurück."""
+
+        ids = [str(i) for i in titel_ids if str(i).strip()]
+        for start in range(0, len(ids), _HINZUFUEGEN_PRO_ANFRAGE):
+            stueck = ids[start : start + _HINZUFUEGEN_PRO_ANFRAGE]
+            self._anfrage(
+                "POST",
+                f"/playlists/{urllib.parse.quote(playlist_id, safe='')}/relationships/items",
+                body={"data": [{"id": i, "type": "tracks"} for i in stueck]},
+                benutzer=True,
+            )
+        return len(ids)
+
+    def meine_playlists(self, *, anzahl: int = 50) -> list[Playlist]:
+        """Die Playlists in der Sammlung des Benutzers."""
+
+        antwort = self._anfrage(
+            "GET",
+            "/userCollectionPlaylists/me/relationships/items",
+            params={"include": "items"},
+            benutzer=True,
+        )
+        details = {
+            str(e.get("id")): e
+            for e in (antwort.get("included") or [])
+            if e.get("type") == "playlists"
+        }
+        ergebnis: list[Playlist] = []
+        for d in antwort.get("data") or []:
+            if d.get("type") != "playlists":
+                continue
+            attr = (details.get(str(d.get("id"))) or {}).get("attributes") or {}
+            ergebnis.append(
+                Playlist(
+                    id=str(d.get("id")),
+                    name=str(attr.get("name", "")),
+                    anzahl=attr.get("numberOfItems"),
+                )
+            )
+        return ergebnis[:anzahl]
+
+    def playlist_finden(self, name: str) -> tuple[Playlist | None, list[Playlist]]:
+        """Sucht eine eigene Playlist nach Namen. Mehrdeutig -> ``None`` + Liste."""
+
+        klein = (name or "").strip().lower()
+        alle = self.meine_playlists(anzahl=200)
+        genau = [p for p in alle if p.name.lower() == klein]
+        if len(genau) == 1:
+            return genau[0], genau
+        teil = [p for p in alle if klein and klein in p.name.lower()]
+        if len(teil) == 1:
+            return teil[0], teil
+        return None, (genau or teil)
diff --git a/backend/integrations/tidal/oauth.py b/backend/integrations/tidal/oauth.py
new file mode 100644
index 0000000..0888e88
--- /dev/null
+++ b/backend/integrations/tidal/oauth.py
@@ -0,0 +1,331 @@
+"""Anmeldung bei TIDAL.
+
+TIDAL kennt zwei Wege, und der Orb braucht beide:
+
+1. **Client Credentials** - nur mit Client-ID und Client-Secret, ohne
+   Benutzer. Damit darf man den Katalog durchsuchen (Titel, Alben,
+   Künstler). Das funktioniert sofort, ganz ohne Anmeldung im Browser.
+2. **Authorization Code mit PKCE** - der Benutzer meldet sich einmal im
+   Browser bei TIDAL an. Erst damit darf der Orb in SEINEM Konto etwas tun:
+   Playlists anlegen, Titel hinzufügen, eigene Playlists ansehen.
+
+Der Ablauf von Weg 2 ist derselbe Loopback-Fluss wie bei Gmail: Browser
+auf, Anmeldung bei TIDAL, TIDAL schickt den Einmalcode an
+``/tidal/callback`` des lokalen Servers, der Code wird gegen ein Token
+getauscht. Das Passwort sieht der Orb nie.
+
+## Wo die Geheimnisse liegen
+
+Client-ID und Client-Secret stehen in der ``.env`` (``TIDAL_CLIENT_ID``,
+``TIDAL_CLIENT_SECRET``), nie im Code und nie in ``config.yaml`` - das
+Projekt liegt auf GitHub. Das Benutzertoken liegt in den Benutzerdaten
+(``tidal/token.json``), verschleiert wie das Gmail-Token, wenn
+``AI_ORB_ENCRYPTION_KEY`` gesetzt ist.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+import secrets
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from backend.integrations.gmail.oauth import Token, _deobfuscate, _obfuscate
+from backend.system.logging_setup import get_logger
+from backend.utils.paths import get_user_dir
+
+logger = get_logger(__name__)
+
+#: Öffentliche Endpunkte von TIDAL - keine Geheimnisse.
+AUTH_ENDPOINT = "https://login.tidal.com/authorize"
+TOKEN_ENDPOINT = "https://auth.tidal.com/v1/oauth2/token"
+
+#: Was der Orb im Konto darf: lesen, suchen, Playlists und Sammlung pflegen.
+#: Lässt sich mit ``TIDAL_SCOPE`` in der .env oder ``tidal.scope`` in der
+#: config.yaml ändern, falls TIDAL die Namen der Bereiche ändert.
+DEFAULT_SCOPE = (
+    "user.read search.read playlists.read playlists.write "
+    "collection.read collection.write"
+)
+
+#: Der Rückweg nach der Anmeldung. Muss im TIDAL-Entwicklerportal GENAU so
+#: als Redirect-URI eingetragen sein.
+DEFAULT_REDIRECT_URI = "http://127.0.0.1:8756/tidal/callback"
+
+
+class TidalAuthFehler(RuntimeError):
+    """Ein Problem bei Anmeldung oder Token."""
+
+
+@dataclass(slots=True)
+class TidalOAuthConfig:
+    """Die Anmeldedaten der Anwendung."""
+
+    client_id: str = ""
+    client_secret: str = ""
+    scope: str = DEFAULT_SCOPE
+    redirect_uri: str = DEFAULT_REDIRECT_URI
+
+    @classmethod
+    def from_env(
+        cls, *, scope: str = "", redirect_uri: str = ""
+    ) -> TidalOAuthConfig:
+        return cls(
+            client_id=os.environ.get("TIDAL_CLIENT_ID", "").strip(),
+            client_secret=os.environ.get("TIDAL_CLIENT_SECRET", "").strip(),
+            scope=(os.environ.get("TIDAL_SCOPE", "").strip() or scope or DEFAULT_SCOPE),
+            redirect_uri=redirect_uri or DEFAULT_REDIRECT_URI,
+        )
+
+    @property
+    def is_configured(self) -> bool:
+        return bool(self.client_id and self.client_secret)
+
+
+def _post_formular(url: str, felder: dict[str, str], *, basic: tuple[str, str] | None = None) -> dict[str, Any]:
+    """Schickt ein Formular an den Token-Endpunkt und liest die JSON-Antwort."""
+
+    kopf = {"Content-Type": "application/x-www-form-urlencoded"}
+    if basic is not None:
+        roh = f"{basic[0]}:{basic[1]}".encode("utf-8")
+        kopf["Authorization"] = "Basic " + base64.b64encode(roh).decode("ascii")
+
+    anfrage = urllib.request.Request(
+        url,
+        data=urllib.parse.urlencode(felder).encode("utf-8"),
+        headers=kopf,
+        method="POST",
+    )
+    try:
+        with urllib.request.urlopen(anfrage, timeout=30) as antwort:
+            return json.loads(antwort.read().decode("utf-8") or "{}")
+    except urllib.error.HTTPError as fehler:
+        text = fehler.read().decode("utf-8", errors="replace")[:400]
+        raise TidalAuthFehler(f"TIDAL lehnt die Anmeldung ab ({fehler.code}): {text}") from fehler
+    except (urllib.error.URLError, TimeoutError, OSError) as fehler:
+        raise TidalAuthFehler(f"TIDAL ist nicht erreichbar: {fehler}") from fehler
+
+
+class TidalAuth:
+    """Verwaltet beide Token: das der Anwendung und das des Benutzers."""
+
+    def __init__(
+        self,
+        config: TidalOAuthConfig | None = None,
+        *,
+        token_path: Path | None = None,
+        post: Any = None,
+    ) -> None:
+        self.config = config or TidalOAuthConfig.from_env()
+        self.token_path = token_path or (get_user_dir() / "tidal" / "token.json")
+        self._token: Token | None = None
+        self._app_token: Token | None = None
+        self._key = os.environ.get("AI_ORB_ENCRYPTION_KEY", "").strip()
+        #: Einschleusbar für Tests - kein Test soll echt bei TIDAL anklopfen.
+        self._post = post or _post_formular
+        #: Der PKCE-Prüfwert und der state der laufenden Anmeldung.
+        self._ausstehend: tuple[str, str] | None = None
+
+    # --- Zustand --------------------------------------------------------------
+
+    @property
+    def is_configured(self) -> bool:
+        return self.config.is_configured
+
+    @property
+    def is_authenticated(self) -> bool:
+        token = self._load_token()
+        return token is not None and bool(token.refresh_token or not token.is_expired)
+
+    # --- Anwendungstoken (nur Katalog) ---------------------------------------
+
+    def app_token(self) -> str:
+        """Ein Token ohne Benutzer - reicht zum Suchen im Katalog."""
+
+        if not self.is_configured:
+            raise TidalAuthFehler(
+                "TIDAL ist nicht eingerichtet: TIDAL_CLIENT_ID und "
+                "TIDAL_CLIENT_SECRET fehlen in der .env."
+            )
+        if self._app_token is not None and not self._app_token.is_expired:
+            return self._app_token.access_token
+
+        antwort = self._post(
+            TOKEN_ENDPOINT,
+            {"grant_type": "client_credentials"},
+            basic=(self.config.client_id, self.config.client_secret),
+        )
+        self._app_token = Token(
+            access_token=str(antwort.get("access_token", "")),
+            expires_at=time.time() + float(antwort.get("expires_in", 3600)),
+            scope=str(antwort.get("scope", "")),
+        )
+        if not self._app_token.access_token:
+            raise TidalAuthFehler("TIDAL hat kein Zugriffstoken geschickt.")
+        return self._app_token.access_token
+
+    # --- Benutzertoken ---------------------------------------------------------
+
+    def user_token(self) -> str:
+        """Ein Token im Namen des Benutzers - nötig für Playlists."""
+
+        token = self._load_token()
+        if token is None:
+            raise TidalAuthFehler(
+                "Du bist bei TIDAL noch nicht angemeldet. Sag „Melde mich bei "
+                "TIDAL an“ - das ist einmalig."
+            )
+        if token.is_expired:
+            if not token.refresh_token:
+                raise TidalAuthFehler(
+                    "Die TIDAL-Anmeldung ist abgelaufen. Sag „Melde mich bei "
+                    "TIDAL an“, um sie zu erneuern."
+                )
+            token = self._erneuern(token)
+        return token.access_token
+
+    def bester_token(self) -> str:
+        """Benutzertoken, wenn vorhanden - sonst das Anwendungstoken."""
+
+        try:
+            return self.user_token()
+        except TidalAuthFehler:
+            return self.app_token()
+
+    def _erneuern(self, token: Token) -> Token:
+        antwort = self._post(
+            TOKEN_ENDPOINT,
+            {
+                "grant_type": "refresh_token",
+                "refresh_token": token.refresh_token,
+                "client_id": self.config.client_id,
+            },
+        )
+        token.access_token = str(antwort.get("access_token", ""))
+        token.expires_at = time.time() + float(antwort.get("expires_in", 3600))
+        if antwort.get("refresh_token"):
+            token.refresh_token = str(antwort["refresh_token"])
+        self._save_token(token)
+        return token
+
+    # --- Anmeldung im Browser --------------------------------------------------
+
+    def anmelde_url(self) -> str:
+        """Baut die Anmelde-URL und merkt sich Prüfwert und state."""
+
+        verifier = secrets.token_urlsafe(64)
+        challenge = (
+            base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest())
+            .decode()
+            .rstrip("=")
+        )
+        state = secrets.token_urlsafe(16)
+        self._ausstehend = (verifier, state)
+
+        params = {
+            "response_type": "code",
+            "client_id": self.config.client_id,
+            "redirect_uri": self.config.redirect_uri,
+            "scope": self.config.scope,
+            "code_challenge_method": "S256",
+            "code_challenge": challenge,
+            "state": state,
+        }
+        return f"{AUTH_ENDPOINT}?{urllib.parse.urlencode(params)}"
+
+    def anmeldung_abschliessen(self, code: str, state: str = "") -> Token:
+        """Tauscht den Einmalcode gegen das Benutzertoken."""
+
+        if self._ausstehend is None:
+            raise TidalAuthFehler(
+                "Es läuft gerade keine TIDAL-Anmeldung. Sag zuerst „Melde mich "
+                "bei TIDAL an“."
+            )
+        verifier, erwartet = self._ausstehend
+        # Der state schützt davor, dass eine fremde Seite dem Orb einen Code
+        # unterschiebt. Fehlt er ganz, lassen wir es durchgehen (manche
+        # Weiterleitungen verlieren ihn), ein FALSCHER state aber nicht.
+        if state and state != erwartet:
+            raise TidalAuthFehler("Der Rückweg passt nicht zur gestarteten Anmeldung.")
+
+        antwort = self._post(
+            TOKEN_ENDPOINT,
+            {
+                "grant_type": "authorization_code",
+                "client_id": self.config.client_id,
+                "code": code,
+                "redirect_uri": self.config.redirect_uri,
+                "code_verifier": verifier,
+            },
+        )
+        token = Token(
+            access_token=str(antwort.get("access_token", "")),
+            refresh_token=str(antwort.get("refresh_token", "")),
+            expires_at=time.time() + float(antwort.get("expires_in", 3600)),
+            scope=str(antwort.get("scope", self.config.scope)),
+        )
+        if not token.access_token:
+            raise TidalAuthFehler("TIDAL hat kein Zugriffstoken geschickt.")
+        self._save_token(token)
+        self._ausstehend = None
+        logger.info("TIDAL-Anmeldung erfolgreich.")
+        return token
+
+    def forget(self) -> bool:
+        self._token = None
+        try:
+            if self.token_path.is_file():
+                self.token_path.unlink()
+            return True
+        except OSError as fehler:
+            logger.error("TIDAL-Token nicht löschbar: %s", fehler)
+            return False
+
+    # --- Speichern -------------------------------------------------------------
+
+    def _load_token(self) -> Token | None:
+        if self._token is not None:
+            return self._token
+        if not self.token_path.is_file():
+            return None
+        try:
+            roh = self.token_path.read_bytes()
+            if self._key and roh[:5] == b"ENC1:":
+                text = _deobfuscate(base64.b64decode(roh[5:]), self._key)
+            else:
+                text = roh.decode("utf-8")
+            self._token = Token.from_dict(json.loads(text))
+            return self._token
+        except (OSError, ValueError) as fehler:
+            logger.warning("TIDAL-Token nicht lesbar: %s", fehler)
+            return None
+
+    def _save_token(self, token: Token) -> None:
+        self._token = token
+        inhalt = json.dumps(token.to_dict(), ensure_ascii=False)
+        try:
+            self.token_path.parent.mkdir(parents=True, exist_ok=True)
+            if self._key:
+                self.token_path.write_bytes(
+                    b"ENC1:" + base64.b64encode(_obfuscate(inhalt, self._key))
+                )
+            else:
+                logger.warning(
+                    "TIDAL-Token wird im Klartext gespeichert. Setze "
+                    "AI_ORB_ENCRYPTION_KEY in der .env, um es zu schützen."
+                )
+                self.token_path.write_text(inhalt, encoding="utf-8")
+            try:
+                os.chmod(self.token_path, 0o600)
+            except OSError:
+                pass
+        except OSError as fehler:
+            logger.error("TIDAL-Token nicht speicherbar: %s", fehler)
