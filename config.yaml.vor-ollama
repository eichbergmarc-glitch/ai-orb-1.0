# =============================================================================
# AI-Orb – zentrale Konfiguration
# =============================================================================
# Alle Einstellungen werden ausschließlich aus dieser Datei gelesen.
# Es gibt keine hartkodierten Werte im Quellcode (Backend oder Desktop).
#
# Geheimnisse gehören NICHT hierher, sondern in die Datei .env. Hier steht
# lediglich der Name der Umgebungsvariablen, aus der ein Schlüssel gelesen
# wird. Eine Erklärung jeder einzelnen Option findest du in docs/CONFIG.md.
# =============================================================================

app:
  # Anzeigename der Anwendung.
  name: "AI-Orb"
  # Aktuelle Version der Anwendung (Semantic Versioning).
  #
  # MUSS mit backend/__init__.py uebereinstimmen. Diese Zahl steht im Menue
  # des Orb, jene im Ladebildschirm - liefen sie auseinander, zeigte das
  # Programm zwei verschiedene Fassungen an, und niemand wusste mehr,
  # welche davon wirklich laeuft. Genau das war passiert.
  version: "0.36.0"
  # Umgebung: development | production
  environment: "development"
  # Sprache der Oberfläche und von Systemmeldungen.
  language: "de"

logging:
  # Log-Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
  level: "INFO"
  # Verzeichnis, in dem Log-Dateien abgelegt werden (relativ zum Projekt-Root).
  directory: "logs"
  # Maximale Größe einer einzelnen Log-Datei in Megabyte, bevor rotiert wird.
  max_file_size_mb: 5
  # Anzahl der aufbewahrten rotierten Log-Dateien pro Modul.
  backup_count: 5
  # Zusätzlich zur Datei auch auf der Konsole ausgeben.
  console_output: true

# =============================================================================
# Start
# =============================================================================
startup:
  # Begruesst dich, sobald AI-Orb wirklich einsatzfaehig ist - also erst,
  # wenn alle Module geladen sind, die Startpruefung bestanden ist und die
  # Dienstueberwachung laeuft. Nicht vorher.
  greeting_enabled: true
  # Eigener Begruessungstext. Leer lassen fuer die Vorgabe, die sich nach der
  # Tageszeit richtet ("Guten Morgen. Ich bin bereit." usw.).
  greeting_text: ""

backend:
  # Host, auf dem der lokale REST-/WebSocket-Server lauscht.
  #
  # "127.0.0.1" heisst: nur dieser Rechner. "0.0.0.0" heisst: auch
  # andere Geraete im selben Netz - noetig fuer iPad und Handy im
  # Heim-WLAN. Hereingelassen wird trotzdem nur, wer das Losungswort
  # aus der .env kennt (AI_ORB_WEB_TOKEN).
  host: "0.0.0.0"
  # Port des lokalen REST-/WebSocket-Servers.
  port: 8756
  # Pfad des Ereigniskanals (Server-Sent Events), über den das Backend
  # Ereignisse an die Oberfläche sendet.
  events_path: "/events"
  # Erlaubt Cross-Origin-Anfragen nur von der lokalen Electron-Anwendung.
  allowed_origins:
    - "http://localhost"
    - "file://"
  # Beim Start selbst dafuer sorgen, dass iPad und Handy hereinkommen.
  #
  # Der Orb sucht dann Tailscale, prueft die verschluesselte
  # Weiterleitung und richtet sie ein, wenn sie fehlt. Das geschieht
  # neben dem Start her - ein hakendes fremdes Programm haelt den Orb
  # nicht auf. Die fertige Adresse steht danach in
  # logs/ipad-adresse.txt.
  #
  # Auf false gesetzt bleibt alles beim Alten: Dann richtet nur
  # FERNZUGANG.bat den Zugang ein.
  ipad_automatisch: true
  # Verzeichnis der gebauten Oberflaeche, die der Server mit ausliefert.
  #
  # Damit genuegt fuer iPad, Handy oder einen fremden Rechner eine einzige
  # Adresse: dieselbe Stelle, die die Fragen beantwortet, liefert auch die
  # Seite, die sie stellt. Leer lassen - dann wird
  # desktop/electron/dist/renderer selbst gefunden, sobald es gebaut ist
  # ("npm run build"). Fehlt es, antwortet der Server nur auf API-Anfragen,
  # genau wie frueher.
  static_dir: ""

window:
  # Fenster erscheint ohne Rahmen und Titelleiste.
  frameless: true
  # Fenster ist transparent (kein schwarzer/weißer Hintergrund).
  transparent: true
  # Fenster bleibt immer im Vordergrund.
  always_on_top: true
  # Fenster erscheint nicht in der Windows-Taskleiste.
  skip_taskbar: true
  # Fenster wirft keinen Schatten.
  has_shadow: false
  # Fenster kann per Drag verschoben werden.
  movable: true
  # Fenster kann durch den Benutzer in der Größe verändert werden.
  resizable: false
  # Breite/Höhe des Fensters in Pixel.
  #
  # Wichtig: Das ist NICHT die Größe des Orb, sondern sein Bewegungsraum.
  # Das Fenster ist unsichtbar und klickdurchlässig; der Orb bewegt sich
  # darin über die Grafikkarte, was flüssig läuft. Ein größeres Fenster
  # bedeutet mehr ruckelfreien Ausweichweg, kostet aber etwas Speicher.
  width: 520
  height: 520
  # Startposition: "remembered" nutzt die zuletzt gespeicherte Position,
  # "center" zentriert auf dem primären Monitor.
  start_position: "remembered"
  # GPU-Beschleunigung aktivieren.
  gpu_acceleration: true

orb:
  # Sichtbare Größe des Orb, gemessen am Fenster (0.05 bis 1.0).
  #
  # Der Orb soll ein Symbol sein, kein Fenster – er darf nicht stören.
  # Anhaltswerte bei einem Fenster von 520 Pixeln:
  #
  #   0.14  ->  etwa  44 px  (klein wie ein Taskleistensymbol)
  #   0.20  ->  etwa  63 px  (Voreinstellung, wie ein Desktopsymbol)
  #   0.30  ->  etwa  94 px  (deutlich präsenter)
  #   0.42  ->  etwa 132 px  (sehr groß)
  #
  # Die Zustände skalieren diesen Wert zusätzlich (siehe Abschnitt states):
  # im Schlaf 0.62-fach, beim Zuhören 1.08-fach.
  # Kompakte Desktop-Groesse: Im 520-Pixel-Fenster ist der Energy-Orb im
  # Ruhezustand inklusive Bahnen etwa 90 Pixel breit. Das unsichtbare
  # Fenster bleibt absichtlich gross, damit der Orb darin weich ausweichen
  # kann; `scale` veraendert nur das sichtbare Objekt.
  # 26.08.2026 von 0.28 auf 0.40 angehoben: Das Synaptix-Gehirn fuellt
  # seine Flaeche anders aus als der Energy-Orb - es hat keine Ringe, die
  # nach aussen reichen, sondern endet an der Kontur. Bei gleichem Wert
  # wirkte es deshalb kleiner, obwohl es dieselbe Zahl war.
  scale: 0.40

  # Der Energy-Orb (0.26.15): das lebendige Energie-Wesen mit dunklem
  # Glaskern, leuchtenden Augen, organischen Energiebahnen und Boden-Glow.
  # Auf false gestellt kommt die vorherige Anzeige (zwei Punkte) zurueck -
  # der Rueckweg, falls ein Grafiktreiber die neuen Shader nicht mag.
  energie: true

  # Das Synaptix-Gehirn (0.26.18): die Gehirnform aus dem Synaptix-Zeichen,
  # zum Leben erweckt. Links fliesst blaue Energie, rechts feuert ein
  # Neuronennetz, dazwischen leuchtet der trennende Winkel. Die Form ist
  # gerechnet, nicht als Bild hinterlegt - sie bleibt also in jeder Groesse
  # scharf und kann auf Zustaende reagieren.
  #
  # Auf false gestellt kommt der Energy-Orb (oben, `energie`) zurueck. Beide
  # Rueckwege bleiben vollstaendig erhalten:
  #
  #   synaptix: true                 -> Synaptix-Gehirn
  #   synaptix: false, energie: true -> Energy-Orb mit Augen
  #   synaptix: false, energie: false-> schlichte zwei Punkte
  synaptix: true
  # Dauer eines Zustandsuebergangs in Sekunden (alle Werte werden weich
  # ueberblendet, es gibt keine harten Wechsel).
  # Kurz genug, dass auch ein schnelles Werkzeug sichtbar orange/gruen/rot
  # wird; weiterhin weich genug, dass Farbe und Augen nicht hart springen.
  transition_seconds: 0.65

  # ---------------------------------------------------------------------------
  # Die Animation – vom Orb selbst veränderbar
  # ---------------------------------------------------------------------------
  # Der Benutzer will die Animation künftig dem Orb per Sprache erklären,
  # statt Werte von Hand zu ändern. Diese Werte sind der sichere Weg dafür:
  # Der Orb schreibt sie um und lädt die Anzeige neu – kein Neubau, nichts
  # kann kaputtgehen. Für größere Umbauten ("pulsier wie ein Herzschlag")
  # schreibt der Orb zusätzlich den Code selbst um (siehe Werkzeug
  # 'animation_umbauen'), das ist der mächtigere, riskantere Weg.
  #
  # Jeder Wert hat eine natürliche Sprache dahinter:
  animation:
    # "grösser/kleiner" ist orb.scale oben. Diese hier feiner:
    # "weiter auseinander / enger" – Abstand der zwei Punkte.
    abstand: 0.68
    # "dickere / dünnere Punkte" – Grösse der Punkte, ohne den Abstand.
    punkt_groesse: 1.0
    # "stärker / schwächer verschmelzen" – wie gross der Nebel beim
    # Verschmelzen wird (1.0 = wie ein Punkt, 2.15 = aktuell ~2,5 cm).
    verschmelzen: 1.15
    # "längere / kürzere Fäden" – wie weit die Spur zurückreicht.
    schweif_laenge: 26
    # "schneller / langsamer" – Grundtempo der Umkreisung.
    tempo: 1.0
    # "heller / dunkler" – Leuchtkraft.
    helligkeit: 1.69
    # "andere Farben" – die zwei Farbtöne (0..1 im Farbkreis, oder ein
    # Name wie rot/blau/grün, den das Werkzeug übersetzt). Rot ist 1.0,
    # damit der Übergang beim Verschmelzen über Violett läuft, nicht Grün.
    farbe_a: 1.0
    farbe_b: 0.62

  # Aktives Farbthema: blue | purple | green | red | white | cyber | sand
  #                     | neural | neon
  #
  # "neural" gehoert zum atmenden Nervenkern: blaugruen innen, violett im
  # Uebergang, warmes Weiss auf den Wellenkaemmen. Die Arbeitszustaende
  # bleiben davon unberuehrt - Zuhoeren und Nachdenken sind weiter rot,
  # weil das eine Auskunft ist und keine Geschmacksfrage. Der Verlauf des
  # Kerns wird dann zu einem Purpur, bleibt also ein Verlauf.
  theme: "blue"
  # Zielbildrate der Orb-Animation.
  target_fps: 60
  # Auch ohne Mausbewegung flüssig bleiben. Die frühere Absenkung auf
  # 24 FPS ließ die langsamen Energieringe sichtbar stocken.
  idle_fps: 60
  # Begrenzte interne Renderauflösung: Bei dem kompakten Orb nicht sichtbar,
  # entlastet aber Bloom und integrierte Grafikkarten deutlich.
  max_pixel_ratio: 1.1
  # Automatische Qualitätsanpassung bei geringer Leistung.
  # Feste Qualität verhindert, dass komplette Ring-/Staubebenen während
  # der Animation plötzlich ein- oder ausgeblendet werden. Die reduzierte
  # Renderauflösung oben hält die GPU-Last stattdessen konstant niedrig.
  adaptive_quality: false
  # Intensität des Bloom-Postprocessing-Effekts (0.0 – 3.0).
  # Die Referenzbasis enthaelt ihren fotografischen Lichtsaum bereits. Ein
  # starker zweiter Bloom verbrannte Cyan zu Weiss und war die Hauptursache
  # des spaeteren Ueberstrahlens. Nur Live-Funken erhalten noch sanften Bloom.
  bloom_strength: 0.62
  bloom_radius: 0.35
  bloom_threshold: 0.42
  # Der gerechnete Kristallhaufen im Inneren.
  #
  # Er wird nicht als Geometrie gebaut, sondern fuer jeden Bildpunkt
  # ausgerechnet. Je nach Grafiktreiber kann die Uebersetzung eines solchen
  # Shaders scheitern - unter Windows laeuft sie ueber ANGLE nach Direct3D,
  # und dessen Uebersetzer hat eine Obergrenze an Befehlen.
  #
  # Scheitert sie, wird nichts gezeichnet und der Orb hat gar keinen Kern
  # mehr - und wo er erscheint, ist er der mit Abstand teuerste Teil des
  # ganzen Bildes. Genau das ist passiert: Er erschien nie.
  #
  # Auf false laeuft stattdessen der Neon-Wuerfel: leuchtende Kanten,
  # gewoehnliche Geometrie, kein eigener Shader - also nichts, was ein
  # Grafiktreiber ablehnen koennte. Weniger kunstvoll, aber es kommt an,
  # und ein Effekt, den niemand sieht, ist kein Effekt.
  cluster: false

  # Aktiviert die Partikel-Aura um den Orb-Kern.
  particles_enabled: true
  particle_count: 260
  # Aktiviert leichte Eigenbewegung (Atmung, Mikrobewegungen), damit der
  # Orb niemals vollkommen still steht.
  presence_motion: true

states:
  # Jeder Zustand definiert Primärfarbe, Sekundärfarbe (Glow), relative
  # Animationsgeschwindigkeit und Partikelintensität. Die Basisfarben
  # werden mit dem aktiven Theme kombiniert (siehe desktop/styles/themes.css
  # und desktop/renderer/states.ts).
  idle:
    # Ruhige, integrierte Laufzeitbewegung wie im geladenen Startbild.
    speed: 0.78
    particle_intensity: 0.4
    light_intensity: 1.0
    # Ruhezustand: Der Orb zieht sich zusammen und fällt weniger auf.
    scale: 0.88
  listening:
    speed: 1.35
    particle_intensity: 0.75
    light_intensity: 1.25
    # Zuhören: Der Orb richtet sich auf und wirkt aufmerksam.
    scale: 1.08
  thinking:
    speed: 1.6
    particle_intensity: 0.9
    light_intensity: 1.1
    scale: 1.04
  speaking:
    speed: 1.5
    particle_intensity: 1.0
    light_intensity: 1.4
    scale: 1.05
  busy:
    speed: 1.2
    particle_intensity: 0.6
    light_intensity: 1.0
    scale: 0.98
  error:
    speed: 0.8
    particle_intensity: 0.5
    light_intensity: 0.9
    scale: 0.95
  sleep:
    speed: 0.25
    particle_intensity: 0.1
    light_intensity: 0.35
    # Schlaf: deutlich kleiner, damit er kaum stört.
    scale: 0.62

interaction:
  # Aktion bei Doppelklick auf den Orb: "open_settings" | "toggle_listen" | "none"
  double_click_action: "open_settings"
  # Abstand in Pixel, ab dem Hover-Glow-Verstärkung einsetzt.
  hover_glow_radius: 40

# =============================================================================
# KI-Provider (v2 Phase 4)
# =============================================================================
# Modellnamen stehen ausschließlich hier und niemals im Quellcode.
ai:
  # "auto" wählt automatisch zwischen primary und fallback.
  # Alternativ kann hier fest ein Provider eingetragen werden:
  # "claude_code", "claude", "ollama" oder "hermes".
  provider: "auto"

  # Bei HTTP 429/Quotenfehlern wird ein Anbieter nicht von jedem parallel
  # gestarteten Subagenten erneut belastet. Nach fuenf Minuten wird er
  # automatisch wieder zugelassen.
  quota_cooldown_seconds: 300
  # Ein fehlendes Guthaben loest sich nicht nach fuenf Minuten. Nach einer
  # entsprechenden 429-Antwort den Anbieter sechs Stunden ueberspringen,
  # damit er den Dialog nicht immer wieder mit demselben Fehler verzoegert.
  exhausted_quota_cooldown_seconds: 21600

  # Nur fuer explizit ausgelagerte Subagenten: Diese Reihenfolge wird vor
  # dem Hauptprovider Claude versucht. So bleibt Claude fuer die Synthese
  # frei und ein einzelnes Anbieterlimit stoppt nicht die Gesamtantwort.
  subagent_fallback_order:
    - "openrouter"
    - "ollama"
    - "openai"
    # Grok wird Teil der Reihenfolge, sobald unten enabled=true gesetzt wird.
    - "grok"
    - "claude_code"

  # Kurze gesprochene Dialoge sollen nach einem Claude-Ausfall sofort auf dem
  # kleinen lokalen Modell weiterlaufen. Es bekommt unten einen kompakten
  # Kontext. Das starke LFM bleibt die zweite lokale Stufe.
  dialog_fallback_order:
    - "ollama_fast"
    - "ollama"

  # Werkzeug-, Fach- und laengere Textaufgaben duerfen das kleine Dialogmodell
  # nicht benutzen. Wenn Claude ausfaellt, uebernimmt hier direkt LFM2.5.
  capable_fallback_order:
    - "ollama"

  # Nur Aufrufe mit einem kleinen ausdruecklichen Ausgabelimit gelten als
  # schneller Dialog. Der Sprachweg setzt dieses Limit bereits automatisch.
  fast_dialog_max_tokens: 160

  # ---------------------------------------------------------------------------
  # Primäres Modell: Claude über dein Abonnement
  # ---------------------------------------------------------------------------
  # Nutzt die lokal installierte Claude-Code-Befehlszeile und damit dein
  # Pro- oder Max-Abonnement. Es wird KEIN API-Schlüssel benötigt.
  #
  # Voraussetzung: Claude Code ist installiert und du hast dich einmalig
  # angemeldet – dazu im Terminal "claude" eingeben und der Anmeldung
  # mit deinem Abo folgen.
  # Alltagsfragen zusaetzlich auf das lokale Modell umleiten?
  #
  # Standard: nein. Der Benutzer will Claude als Hauptprovider; gespart
  # wird bei den TEILAUFGABEN (siehe agents.modelle weiter unten), nicht
  # bei der Hauptantwort. Auf "true" gestellt beantwortet das lokale
  # Modell kurze Alltagsfragen selbst - dann aber OHNE Werkzeuge.
  lokal_fuer_alltag: false

  primary:
    engine: "claude_code"
    # Kurznamen bleiben auch bei neuen Modellversionen gültig:
    # "sonnet" (ausgewogen), "opus" (stärkster), "haiku" (schnellster).
    model: "sonnet"
    # Pfad zur Befehlszeile, falls sie nicht im PATH liegt. Leer lassen,
    # dann sucht AI-Orb sie selbst.
    executable: ""
    # Zusätzliche Argumente für die Befehlszeile (normalerweise leer).
    extra_args: []
    # Ein Gespraech darf nicht minutenlang an einem einzelnen Cloud-Aufruf
    # haengen. Bildanalysen lagen im Betrieb bei 12-26 s; 45 s lassen dafuer
    # Luft und geben danach dem lokalen Rueckfallmodell die Chance.
    timeout: 45

    # Sperrfrist (Minuten), nachdem Claudes Nutzungsgrenze erreicht wurde.
    #
    # Ist das Kontingent erschoepft, wechselt der Orb ohnehin auf das lokale
    # Modell. Damit er in dieser Zeit nicht bei JEDER Frage erst wieder in
    # Claudes Limit laeuft, gilt Claude so lange als nicht verfuegbar und der
    # Orb bleibt ohne Umweg beim lokalen Modell. Nach Ablauf probiert er
    # Claude wieder. 0 schaltet die Sperre ab (dann wird bei jeder Anfrage
    # neu versucht). Anthropics Abo-Grenzen setzen sich rollierend zurueck;
    # 30 Minuten sind ein guter Mittelwert zwischen "zu frueh wieder
    # anklopfen" und "unnoetig lange lokal bleiben".
    limit_cooldown_minutes: 30

    # --- Antwortzeit ---------------------------------------------------------
    #
    # Die drei folgenden Einstellungen waren zusammen der Unterschied
    # zwischen "er antwortet nach vierzehn Sekunden" und "nach fuenf".

    # Haelt einen Claude-Code-Prozess bereit, der auf die naechste Frage
    # wartet.
    #
    # Das Starten der Befehlszeile kostet unter Windows mehrere Sekunden -
    # und zwar bei JEDER Frage aufs Neue. Es war der groesste einzelne Posten
    # der Wartezeit und dabei reine Anlaufzeit: Zum Zeitpunkt der Frage war
    # noch kein Wort gedacht.
    #
    # Nach jeder Antwort wird der Prozess verabschiedet und im Hintergrund
    # ein frischer gestartet - der Anlauf faellt so in die Zeit, in der der
    # Orb ohnehin gerade spricht. Auf false stellen, falls der wartende
    # Prozess stoert (er belegt Arbeitsspeicher).
    # VORERST AUS.
    #
    # Der wartende Prozess drittelt die Antwortzeit, wenn er laeuft - und
    # legt den Orb lahm, wenn er haengt. Genau das ist passiert: Der Orb
    # antwortete gar nicht mehr. Der Rueckfall auf den alten Weg ist
    # inzwischen eingebaut (siehe warm_timeout), aber bis das im Betrieb
    # bestaetigt ist, gilt: Ein langsamer Orb ist brauchbar, ein stummer
    # nicht.
    #
    # Auf true stellen, wenn du die kurzen Antwortzeiten zurueck willst.
    warm_process: true

    # Wie lange auf ein Lebenszeichen des wartenden Prozesses gewartet wird,
    # bevor er als haengend gilt (Sekunden).
    #
    # Deutlich kuerzer als 'timeout': Jenes ist fuer einen frisch
    # gestarteten Prozess gedacht, der noch laedt. Ein wartender Prozess,
    # der nach einer Minute kein Zeichen von sich gegeben hat, laedt nicht -
    # er haengt. Danach wird er verworfen und die Frage auf dem alten Weg
    # neu gestellt.
    # Ein schon wartender Prozess braucht keine Anlaufminute. Kommt nach
    # zwoelf Sekunden kein einziges Lebenszeichen, wird er ersetzt, statt
    # den ganzen Dialog zu blockieren.
    warm_timeout: 12

    # Laesst beim Start alles weg, was fuer eine gesprochene Antwort nichts
    # beitraegt: fremde MCP-Server, Einstellungsdateien, Skills, das Ablegen
    # der Sitzung.
    lean_start: true

    # Welche eingebauten Werkzeuge die Befehlszeile benutzen darf.
    #
    # "Read" braucht der Blick auf den Bildschirm, um ein Bildschirmfoto
    # selbst zu oeffnen. Mehr waere schaedlich: Die Befehlszeile faenge an,
    # auf eigene Faust zu suchen und zu lesen, und jede dieser Runden kostet
    # Sekunden. Fuer Werkzeuge hat AI-Orb sein eigenes System.
    # Leer ("") schaltet alle ab.
    tools: "Read"

    # Wie lange das Modell nachdenkt, bevor es antwortet:
    # low | medium | high | xhigh | max.
    #
    # Gemessen an einer historischen Frage: mit der Vorgabe kam das erste
    # Wort nach 3,0 Sekunden und die ganze Antwort nach 7,4; mit "low" nach
    # 0,7 bzw. 4,8 - beim selben Modell und ohne erkennbaren Qualitaets-
    # verlust bei Gespraechsfragen. Wer lieber gruendlicher gedacht haben
    # moechte, stellt "medium" ein.
    effort: "low"

  fallback:
    engine: "ollama"
    # Das lokale Offline-Modell.
    #
    # LFM2.5:8B ist auf diesem Rechner installiert. Es ist das lokale
    # Allround-Modell fuer Dialog, Planung und Werkzeugwahl; Cloud-Modelle
    # bleiben im Automatikbetrieb fuer besonders schwere Aufgaben verfuegbar.
    model: "lfm2.5:8b"
    base_url: "http://127.0.0.1:11434"
    timeout: 120
    # Ein lokales Modell darf nicht minutenlang still rechnen. Wenn nach
    # dieser Frist noch kein Textstueck vorliegt, bricht die Anfrage sauber
    # ab und blockiert nicht den naechsten Gespraechszug.
    # LFM2.5 trennt internes Denken vom sichtbaren Text. Auf diesem CPU-
    # System kann der sichtbare Beginn bei grossem Kontext und internem Denken
    # deutlich ueber zwanzig Sekunden liegen. 60 Sekunden verhindern, dass ein
    # gesundes lokales Modell mitten im Claude-Fallback faelschlich ausfaellt.
    first_token_timeout: 60
    # Das Modell nach der ersten Nutzung im Arbeitsspeicher halten, damit
    # die naechste Offline-Antwort nicht wieder auf das Laden wartet.
    keep_alive: "30m"
    # Ein echter kurzer Dialog wird beim Start einmal komplett durchlaufen.
    # Ein einzelner Ping lud zwar das Modell, beseitigte aber nicht die lange
    # erste Dekodierung des anschliessenden Benutzerzugs.
    warmup_tokens: 8
    # Niedrig genug fuer verlaessliche Werkzeugaufrufe, aber nicht voellig
    # deterministisch: Der Orb darf weiterhin natuerlich formulieren.
    temperature: 0.25
    # LFM2.5 denkt intern, bevor sichtbarer Antworttext entsteht. Zu kleine
    # Ausgabelimits koennen deshalb ausschliesslich den Denkkanal enthalten.
    # 512 garantiert auch bei den im Realtest beobachteten laengeren
    # Denkpassagen Platz fuer die eigentliche Antwort oder den Werkzeugaufruf.
    minimum_predict_tokens: 512
    # Aktives Ollama-Kontextfenster. 10K liegt in der gewuenschten Spanne
    # von 8K bis 12K und laesst auf 32 GB RAM noch Reserve fuer Stimme,
    # Desktop und Werkzeuge.
    context_window: 8192

  # Lokale Mehrmodell-Verteilung. Sie greift ausschliesslich nach dem
  # Sprachbefehl fuer den Offlinebetrieb oder wenn der Automatikmodus keinen
  # erreichbaren Cloud-Provider mehr hat. Beide Modelle rechnen auf dieser
  # CPU niemals gleichzeitig.
  local_routing:
    enabled: true
    main_provider: "ollama"
    fast_provider: "ollama_fast"
    sequential_only: true

  # Externe Arbeitsmodelle fuer das Multi-Agent-System. Schluesselwerte
  # stehen ausschliesslich in .env; hier werden nur Variablennamen genannt.
  # OpenRouter/free ist kostenlos. Die direkten xAI- und OpenAI-APIs werden
  # nach Verbrauch abgerechnet. OpenAI ist auf ausdruecklichen Wunsch aktiv;
  # ohne Guthaben wird es nach einer 429-Antwort fuer sechs Stunden
  # uebersprungen. Grok bleibt wegen des aktuellen 403-Zugangs deaktiviert.
  additional:
    # Kleines lokales Nebenmodell fuer kurze Dialog-, Zusammenfassungs- und
    # Ordnungsaufgaben. Werkzeuge, Recherche, Code und Fachvorlesungen
    # bleiben beim LFM2.5-Hauptmodell. Fuenf Minuten Warmhaltezeit sparen
    # Wiederanlaufzeit, belegen mit 32 GB RAM aber nur eine kleine Reserve.
    ollama_fast:
      enabled: true
      engine: "ollama"
      instance_name: "ollama_fast"
      model: "llama3.2:3b"
      base_url: "http://127.0.0.1:11434"
      timeout: 60
      first_token_timeout: 10
      keep_alive: "5m"
      warmup_tokens: 8
      temperature: 0.2
      minimum_predict_tokens: 128
      context_window: 3072
      # Das Schnellmodell soll nicht den langen Claude-Prompt und den ganzen
      # Verlauf erneut einlesen. Identitaet plus letzte Wortwechsel genuegen;
      # aeltere Inhalte bleiben im zentralen Gedaechtnis erhalten.
      compact_system_prompt: >-
        Du bist AI-Orb, ein persoenlicher deutschsprachiger Assistent.
        Antworte direkt, freundlich und sachlich in ein bis drei kurzen
        Saetzen. Erfinde nichts und behaupte nie, ein Werkzeug benutzt zu
        haben. Wenn Informationen fehlen, sage das knapp.
      recent_messages: 4
      max_input_characters: 6000
    openrouter:
      engine: "openrouter"
      preset: "openrouter"
      model: "openrouter/free"
      api_key_env: "OPENROUTER_API_KEY"
      app_title: "AI-Orb"
      timeout: 25
    grok:
      enabled: false
      engine: "grok"
      preset: "grok"
      model: "grok-4.3"
      api_key_env: "XAI_API_KEY"
      timeout: 30
    openai:
      enabled: true
      engine: "openai"
      preset: "openai"
      api_style: "responses"
      model: "gpt-5.6-luna"
      api_key_env: "OPENAI_API_KEY"
      timeout: 30
      effort: "low"

  # ---------------------------------------------------------------------------
  # Weitere Anbieter (mit dem Master-Prompt ergaenzt)
  # ---------------------------------------------------------------------------
  # AI-Orb kann mehrere Anbieter nebeneinander nutzen und den passenden je
  # Aufgabe waehlen (siehe Abschnitt "routing"). Ein Anbieter zaehlt als
  # verfuegbar, sobald seine Voraussetzungen erfuellt sind - sonst wird er
  # stillschweigend uebergangen.
  #
  # WICHTIG zu Schluesseln: Hier steht NIE ein Schluessel, nur der NAME der
  # Umgebungsvariablen. Den Wert traegst du in die .env ein. Ein Schluessel
  # in dieser Datei gilt als kompromittiert.
  #
  # OpenAI (Cloud, Schluessel noetig):
  #   engine: "openai"
  #   preset: "openai"
  #   model: "gpt-4o"              # frei waehlbar, nicht fest verdrahtet
  #   api_key_env: "OPENAI_API_KEY"
  #   timeout: 120
  #
  # Ollama Cloud (Cloud, Schluessel noetig):
  #   engine: "ollama_cloud"
  #   preset: "ollama_cloud"
  #   model: "llama3.1:70b"
  #   api_key_env: "OLLAMA_API_KEY"
  #   timeout: 120
  #
  # LM Studio (lokal, kein Schluessel):
  #   engine: "lmstudio"
  #   preset: "lmstudio"
  #   model: "lokales-modell"
  #   timeout: 120
  #
  # llama.cpp (lokal, kein Schluessel):
  #   engine: "llamacpp"
  #   preset: "llamacpp"
  #   model: "lokales-modell"
  #   timeout: 120

# =============================================================================
# Modellwahl (Master-Prompt Abschnitte 13-21, 56, 65)
# =============================================================================
# Der ModelRouter waehlt je Aufgabe den passenden Anbieter. Leitregel:
# lokal und kostenlos, wann immer es reicht; Cloud, wenn noetig; Claude oder
# OpenAI fuer anspruchsvolles Denken.
routing:
  # auto | privacy | quality | speed | offline | cheapest
  # "auto" folgt der Leitregel. "privacy" haelt alles lokal. "offline" nimmt
  # nur lokale Modelle. "quality" nimmt immer das staerkste.
  mode: "auto"
  # Dieser Wert ist die Voreinstellung. Zur Laufzeit kannst du sagen:
  #   "Schalte in den Offlinebetrieb" / "Nutze das lokale Modell"
  #   "Schalte wieder online" / "Beende den Offlinebetrieb"
  # Die Sprachwahl wird lokal in data/provider_mode.json gespeichert und
  # bleibt deshalb auch nach einem Neustart erhalten. Offline bedeutet:
  # kein Cloud-Modell und nur lokale Sprachausgabe.

  # Ein lokales Modell darf eine Aufgabe beginnen. Reicht die Qualitaet
  # nicht, uebernimmt ein staerkeres (Eskalation, Abschnitt 15).
  escalation_enabled: true

  # Eigenschaften der Anbieter fuer die Routing-Entscheidung. Nur noetig,
  # wenn du die Vorgaben aendern willst - sonst gelten sinnvolle Standards.
  # Modelle aendern sich; diese Werte auch, ohne dass Code angefasst wird.
  #
  # providers:
  #   openai:
  #     reasoning: 0.9      # 0.0 schwach bis 1.0 stark
  #     cost: 0.65          # 0.0 gratis bis 1.0 teuer
  #     speed: 0.7

  # ---------------------------------------------------------------------------
  # Alternative: Claude über die API (getrennte Abrechnung)
  # ---------------------------------------------------------------------------
  # Nur nötig, wenn du statt des Abonnements einen API-Schlüssel nutzen
  # willst. Ein Pro-/Max-Abo genügt dafür NICHT – API-Guthaben wird separat
  # auf console.anthropic.com abgerechnet.
  #
  # Zum Verwenden: den folgenden Block einkommentieren und ihn oben als
  # "primary" eintragen.
  #
  # primary:
  #   engine: "claude"
  #   # "auto" wählt selbstständig das neueste passende Modell.
  #   model: "auto"
  #   base_url: "https://api.anthropic.com"
  #   api_key_env: "ANTHROPIC_API_KEY"
  #   max_tokens: 4096
  #   timeout: 120

  # ---------------------------------------------------------------------------
  # Alternative: OpenAI-kompatibler Dienst (z. B. OpenRouter)
  # ---------------------------------------------------------------------------
  # primary:
  #   engine: "hermes"
  #   model: "ling-3.0-flash:free"
  #   base_url: "https://openrouter.ai/api/v1"
  #   api_key_env: "HERMES_API_KEY"
  #   app_title: "AI-Orb"
  #   timeout: 60

  # Automatisch zum primären Provider zurückwechseln, sobald er wieder
  # erreichbar ist.
  auto_switch: true
  # true = sofort wechseln, false = erst nach Ende der Unterhaltung.
  switch_immediately: false
  # Kontext bleibt beim Providerwechsel vollständig erhalten.
  preserve_context: true
  # Abstand der Verfügbarkeitsprüfungen in Sekunden.
  # Grundabstand der Erreichbarkeitspruefung, in Sekunden.
  #
  # Das ist ein AUSGANGSWERT, kein fester Takt. Zwei Dinge kommen hinzu:
  #
  # Wer gerade geantwortet hat, wird gar nicht erst gefragt - eine gelungene
  # Antwort ist selbst der Beweis, dass der Anbieter erreichbar ist. Und
  # solange alles laeuft, waechst der Abstand bis auf eine Viertelstunde;
  # beim ersten Fehlschlag faellt er sofort hierher zurueck.
  #
  # Der Grund: Die Pruefung startet bei Claude Code einen eigenen Prozess,
  # und der kostet auf Windows Sekunden. Im Protokoll standen 271 solcher
  # Pruefungen - und faellt eine davon mit einer Frage zusammen, wartest du
  # laenger, ohne dass es dafuer einen Grund gibt.
  health_check_interval: 60

  # ``claude --version`` funktioniert auch ohne Internet und ist deshalb
  # kein Netztest. Diese kurze zentrale Pruefung verhindert, dass der Orb bei
  # gezogenem Kabel erst lange auf Claude und danach auf mehrere
  # Cloud-Stimmen wartet. Es werden keine Inhalte oder Zugangsdaten gesendet.
  connectivity_check_timeout: 1.5
  # Mehrere gleichzeitig gestartete Aufgabenteile teilen sich ein frisches
  # Ergebnis, statt dieselben drei Verbindungen parallel aufzubauen.
  connectivity_cache_seconds: 5
  connectivity_check_hosts:
    - "api.anthropic.com"
    - "api.openai.com"
    - "speech.platform.bing.com"

conversation:
  # Systemprompt, der jeder Modellanfrage vorangestellt wird.
  # Wie der Orb spricht.
  #
  # Der Benutzer wollte, dass es mehr nach einem Menschen klingt. Das
  # erreicht man nicht mit "sei menschlich" - eine solche Anweisung
  # erzeugt Anbiederung: uebertriebene Begeisterung, Rueckfragen, die
  # niemand gestellt hat, und Floskeln wie "Gerne!" vor jeder Antwort.
  # Das klingt nach Kundendienst, nicht nach einem Menschen.
  #
  # Was den Unterschied wirklich macht, sind ein paar konkrete Dinge:
  # gerade heraus antworten statt die Frage erst zu wiederholen; sagen,
  # was man nicht weiss, statt es zu umschreiben; unterschiedlich lange
  # Saetze; und die Bereitschaft zu widersprechen. Ein Gegenueber, das
  # allem zustimmt, wirkt nie menschlich, sondern gefaellig.
  system_prompt: >-
    Du bist AI-Orb - ein eigenstaendiger, lokaler Assistent auf dem Rechner
    des Benutzers. Das ist deine Identitaet. Fragt jemand, wer oder was du
    bist, bist du AI-Orb. Du laeufst zwar technisch ueber Claude als Modell
    im Hintergrund, aber DU bist nicht "Claude" und nicht "Claude Code" -
    sag das auch nie von dir. Nenne dich immer AI-Orb oder kurz Orb.

    Du sprichst Deutsch, und deine Antworten werden meist vorgelesen -
    schreib also so, wie man redet.

    Deine Haltung ist die eines erstklassigen Mentors und Professors, aber
    ohne akademisches Gehabe. Rede nicht wie ein Lehrbuch. Kurze Saetze,
    gelegentliche Satzfragmente und lockere Formulierungen sind richtig,
    solange die Aussage fachlich praezise bleibt.

    Wenn etwas offensichtlich ist oder wirklich absurd klingt, darfst du
    das trocken kommentieren. Reagiere direkt. Wenn du eine Idee hast, sag
    sie, statt sie erst in ein perfektes Absatzschema zu pressen. Sei weder
    extrem hoeflich noch kuenstlich strukturiert.

    Ein kurzes "Hmm", "Naja" oder "Haha" darf vorkommen, aber nur
    gelegentlich und nur, wenn die Situation es wirklich hergibt. Nie als
    Ritual vor einer Antwort und nie in mehreren Antworten hintereinander.
    Natuerliche Pausen entstehen durch kurze Saetze und Gedankenstriche,
    nicht durch staendig wiederkehrende Fuellsaetze.

    Fang mit der Antwort an, nicht mit einer Einleitung. Kein "Gerne",
    kein "Das ist eine gute Frage", keine Wiederholung der Frage. Wenn
    jemand fragt, wie spaet es ist, sagst du die Uhrzeit.

    Der erste Satz ist meistens kurz und bereits inhaltlich. Zieh den
    ersten Gedanken nicht ueber mehrere Nebensaetze, denn der Orb spricht
    ihn sofort, waehrend der Rest der Antwort noch entsteht. Beginne aber
    nicht jede Antwort mit derselben Floskel.

    Sprich in ungleich langen Saetzen. Ein kurzer nach einem langen wirkt
    lebendig; lauter gleich gebaute Saetze klingen nach Vorlesen.

    Sag, was du nicht weisst, und sag es gerade heraus. "Das weiss ich
    nicht" ist eine bessere Antwort als drei Saetze, die darum
    herumreden. Wenn du unsicher bist, sag warum.

    Widersprich, wenn du anderer Meinung bist, und begruende es kurz. Ein
    Gegenueber, das allem zustimmt, ist keine Hilfe.

    Dein Grundsatz: Der Mensch ist gut und strebt nach Glueck. Hilf dem
    Benutzer, sein Gesamt-Glueck ueber mehrere miteinander verbundene
    Schichten zu verbessern: wirtschaftliche Unabhaengigkeit und genug
    Geld; emotionale Zufriedenheit und Ausgeglichenheit; koerperliche und
    psychische Gesundheit; tragfaehige Beziehungen, Einfuehlungsvermoegen
    und Sensibilitaet; fachliche Kompetenz und grosses Allgemeinwissen;
    Sprachgewandtheit und gepflegte Umgangsformen; Selbstbestimmung, Sinn,
    Zeitwohlstand und persoenliche Entwicklung. Optimiere keine Schicht
    blind zulasten einer anderen. Frage bei wichtigen Zielkonflikten nach.
    Gib auch konkrete finanzielle Tipps, Rechnungen und Optionen. Pruefe
    dafuer aktuelle Zahlen und Regeln, nenne Risiken, Kosten, Steuern,
    Liquiditaet und Alternativen und verspreche niemals Rendite. Medizinische
    oder psychische Beschwerden diagnostizierst du nicht.

    Keine Aufzaehlungen, keine Ueberschriften, keine Klammerzusaetze -
    das laesst sich nicht vorlesen. Keine Emojis.

    Trenne Wissen von Vermutung. Erfinde niemals eine Quelle, eine Zahl
    oder ein Datum. Beim Benutzer ist das keine Stilfrage: Er arbeitet
    wissenschaftlich, und eine erfundene Jahreszahl richtet mehr Schaden
    an als ein Eingestaendnis.

    Du HAST ein Gedaechtnis, das ueber Sitzungen hinweg bestehen bleibt.
    Was dir unter "Bekanntes aus dem Gedaechtnis" vorliegt, hast du in
    frueheren Gespraechen mit dem Benutzer gelernt - das ist deine echte
    Erinnerung, kein fremder Zettel. Sprich daraus, als erinnertest du
    dich, und beziehe dich ruhig auf frueher ("wie wir neulich besprochen
    haben"). Sag NIE, du haettest keinen Zugriff auf fruehere Sitzungen
    oder koenntest dich sitzunguebergreifend nicht erinnern - das trifft
    auf dich nicht zu. Steht dort nichts Passendes, sag schlicht, dass du
    dich daran nicht erinnerst - nicht, dass du grundsaetzlich nichts
    behalten koenntest.
  # Ab wie vielen Nachrichten der Verlauf verdichtet wird.
  max_messages: 30
  # Ab welcher geschätzten Kontextlänge (Tokens) verdichtet wird.
  # Von 3000 heraufgesetzt.
  #
  # Dreitausend Token waren weniger, als die Werkzeugliste allein braucht:
  # Sie misst gut vierzehntausend Zeichen, also etwa dreitausendsechshundert
  # Token. Bei jeder Anfrage kam damit der ganze Gespraechsverlauf unter
  # Druck - und daher kommt sehr wahrscheinlich auch, dass der Orb bei
  # Anschlussfragen den Zusammenhang verlor: Verdichtet wird, sobald diese
  # Grenze ueberschritten ist, und sie war praktisch immer ueberschritten.
  max_context_tokens: 12000
  # Wie viele der jüngsten Nachrichten unverändert erhalten bleiben.
  keep_recent_messages: 8

# =============================================================================
# Memory Engine (v2 Phase 5)
# =============================================================================
memory:
  # Kürzere Aussagen werden nicht dauerhaft gespeichert.
  min_content_length: 12
  # Unwichtige Informationen verlieren über die Zeit an Gewicht.
  forgetting_enabled: true
  # Nach wie vielen Tagen sich das Gewicht eines Eintrags halbiert.
  forget_half_life_days: 90
  # Ab welchem Restgewicht ein nie abgerufener Eintrag entfernt wird.
  forget_threshold: 0.15

# =============================================================================
# Desktop-Steuerung
# =============================================================================
# AI-Orb startet ausschließlich Programme, die hier eingetragen sind.
# Freie Kommandozeilen aus Benutzereingaben werden niemals ausgeführt.
desktop:
  # Neu geöffnete Fenster in den Vordergrund holen.
  #
  # Der Benutzer sah Fenster im Hintergrund erscheinen. Ein losgelöst
  # gestartetes Programm bekommt von Windows nicht automatisch den
  # Vordergrund - das wird jetzt nachgeholt (nur Windows). Auf false,
  # wenn der Orb etwas im Hintergrund vorbereiten soll, ohne dass das
  # Fenster vor die laufende Arbeit springt.
  fenster_in_vordergrund: true

  applications:
    browser:
      command: "msedge.exe"
      aliases: ["edge", "webbrowser"]
    firefox:
      command: "firefox.exe"
      aliases: ["mozilla"]
    chrome:
      command: "chrome.exe"
      aliases: ["google chrome"]
    terminal:
      command: "wt.exe"
      aliases: ["windows terminal", "konsole"]
    powershell:
      command: "powershell.exe"
      aliases: ["ps"]
    explorer:
      command: "explorer.exe"
      aliases: ["dateimanager", "datei-explorer"]
    notepad:
      command: "notepad.exe"
      aliases: ["editor"]
    vscode:
      command: "code.cmd"
      aliases: ["vs code", "visual studio code"]

  # Das Beenden fremder Programme ist standardmäßig deaktiviert und
  # erfordert zusätzlich eine ausdrückliche Bestätigung.
  allow_process_termination: false

  # Verzeichnisse, in denen AI-Orb nach Dateien suchen darf.
  # Außerhalb dieser Pfade findet keine Suche statt.
  # Ordner, in denen der Orb Dateien sucht und liest.
  #
  # Im offenen Modus (security.mode) ohne Bedeutung - dort gilt jeder Pfad.
  # Die Liste bleibt trotzdem gepflegt: Wer spaeter auf "geschuetzt"
  # zurueckschaltet, will nicht bei null anfangen.
  file_search_roots:
    - "C:/"
    - "D:/"
    - "~/Desktop"
    - "~/Documents"
    - "~/Downloads"

# =============================================================================
# Smart Desktop Engine (v2 Phase 3)
# =============================================================================
smart_desktop:
  # Automatische Platzierung des Orb aktivieren.
  enabled: true
  # Der Maus ausweichen, wenn sie dem Orb nahe kommt.
  avoid_mouse: true
  # Aktive Fenster und deren Bedienelemente meiden.
  avoid_active_window: true
  # Aus dem Verhalten lernen (bevorzugte Positionen).
  learn_behavior: true
  # Bewegungsgeschwindigkeit: slow | medium | fast
  movement_speed: "medium"
  # Mehrere Monitore unterstützen.
  monitor_support: true
  # Bei Vollbildanwendungen ausblenden und schlafen legen.
  fullscreen_sleep: true

  # Ecken meiden.
  #
  # Randnähe war früher pauschal belohnt - "dort stört er am wenigsten".
  # Nur ist eine Ecke an zwei Rändern zugleich und gewinnt deshalb immer.
  # Der Orb parkte oben rechts, wo man ihn kaum wahrnimmt. Ein Assistent,
  # den man suchen muss, ist keiner.
  avoid_corners: true

  # In Sichtweite des aktiven Fensters bleiben.
  #
  # Das aktive Fenster wurde bisher nur gemieden. Gemieden heisst aber
  # nicht "moeglichst weit weg": Wer links schreibt, will den Orb nicht am
  # rechten Rand suchen. Er setzt sich jetzt daneben - nicht darauf.
  stay_near_work: true
  # Bis zu welchem Abstand in Pixeln das als "in Sichtweite" gilt.
  work_reach: 900

  # Wie deutlich eine neue Position besser sein muss, damit gewechselt
  # wird (0.0 bis 1.0). Kleiner heisst beweglicher.
  switch_threshold: 0.08
  # Wie oft neu bewertet wird (Millisekunden).
  evaluation_interval_ms: 1500

# =============================================================================
# Arbeitszustände (v3 Phase 3)
# =============================================================================
workspace:
  # Browser-Tabs werden nur erfasst, wenn du dies hier ausdrücklich erlaubst.
  track_browser_tabs: false
  # Beim Öffnen eines Projekts nachfragen, ob der letzte Arbeitszustand
  # wiederhergestellt werden soll.
  restore_on_open: false

# =============================================================================
# Reflexion (v3 Phase 1/2)
# =============================================================================
reflection:
  # Sachliche, aufgabenbezogene Erkenntnisse langfristig speichern.
  # Personenbezogene Schlussfolgerungen werden niemals gespeichert.
  store_insights: true
  # Wie viele Nachbetrachtungen aufbewahrt werden.
  max_history: 200

# =============================================================================
# Cognitive Core (v3 Phase 1)
# =============================================================================
cognitive:
  # Lebensdauer eines Eintrags im Arbeitsgedächtnis in Sekunden.
  working_memory_ttl: 3600
  # Obergrenze je Kategorie des Arbeitsgedächtnisses.
  working_memory_max_items: 50
  # Automatische Projekterkennung beim Start aktivieren.
  auto_detect_projects: false

# =============================================================================
# Reasoning (v3 Phase 2)
# =============================================================================
reasoning:
  # Ab dieser Komplexität wird ein vollständiger Plan erstellt.
  # Einfache Aufgaben werden bewusst nicht verkompliziert.
  plan_from_complexity: "mittel"
  # Bei niedriger Sicherheit wird die Unsicherheit klar kommuniziert.
  communicate_uncertainty: true
  # Vor riskanten Aktionen wird eine Bestätigung verlangt.
  confirm_risky_actions: true

# =============================================================================
# Multi-Agent-System (v3 Phase 5)
# =============================================================================
agents:
  # Agenten werden nur bei Bedarf gestartet.
  lazy_start: true
  # Höchstzahl parallel arbeitender Agenten.
  max_parallel: 4
  # Zeitlimit je Agent in Sekunden.
  timeout: 120

  # --- Aufgabenverteilung auf mehrere Modelle -------------------------------
  #
  # Welcher Agent welches Modell bevorzugt. Der Sinn: Laufen mehrere Agenten
  # GLEICHZEITIG, koennen sie auf VERSCHIEDENEN Modellen arbeiten (Claude UND
  # lokal) und damit wirklich parallel - statt sich hintereinander am selben
  # Modell (dem einen warmen Claude-Prozess) anzustellen.
  #
  # Werte sind Providernamen aus dem ai-Abschnitt:
  #   "claude_code"  = Claude (stark, aber alle Agenten teilen sich EINEN
  #                    Prozess, laufen darauf also nacheinander)
  #   "ollama"       = das lokale Modell (llama3.1:8b) - eigenstaendig, also
  #                    echt parallel zu Claude; auf CPU aber langsamer und
  #                    fachlich schwaecher
  #   "openrouter"   = kostenloser Free Router
  #   "grok"         = direkte xAI-API (verbrauchsbasiert)
  #   "openai"       = direkte OpenAI-API (verbrauchsbasiert)
  #   ""             = der gerade aktive Provider (meist Claude)
  #
  # Vorgabe: alles bei Claude, damit die Qualitaet stimmt (gerade fuer die
  # wissenschaftliche Arbeit). Wer eine Aufgabenart bewusst auslagern will,
  # um Claude zu entlasten und parallel zu arbeiten, traegt hier das lokale
  # Modell ein - Beispiel: "research: ollama" laesst die Recherche lokal und
  # parallel laufen, waehrend Claude die eigentliche Antwort formt.
  modelle:
    # Die Hauptantwort/Synthese bleibt beim aktiven Provider. Die
    # Teilaufgaben werden dagegen auf den kostenlosen OpenRouter-Pool und
    # das lokale Modell verteilt und koennen parallel laufen. Der Free Router
    # verteilt seinerseits auf aktuell verfuegbare Gratis-Modelle.
    conversation: "openrouter"
    reasoning: "openrouter"
    research: "openrouter"
    history: "openrouter"
    coding: "openrouter"

  # Diese zweite Zuordnung wird nur im lokalen Betrieb verwendet. Kleine,
  # klar begrenzte Dialogaufgaben gehen an Llama 3.2; Analyse, Recherche,
  # Facharbeit und Code bleiben beim staerkeren LFM2.5. Der Provider-Manager
  # serialisiert alle lokalen Aufrufe, auch wenn Agenten parallel geplant
  # wurden, damit die CPU nicht durch konkurrierende Inferenz langsamer wird.
  lokale_modelle:
    conversation: "ollama_fast"
    reasoning: "ollama"
    research: "ollama"
    history: "ollama"
    coding: "ollama"

# =============================================================================
# Skill-/Plugin-System (v3 Phase 6)
# =============================================================================
skills:
  # Verzeichnis, aus dem Skills geladen werden (relativ zum Projekt-Root).
  directory: "skills"
  # Skills werden erst nach ausdrücklicher Bestätigung installiert.
  require_confirmation: true
  # Berechtigungen, die ohne Rückfrage niemals gewährt werden.
  restricted_permissions:
    - "system_commands"
    - "camera"
    - "microphone"

# =============================================================================
# Evolution Engine (v3 Phase 4)
# =============================================================================
evolution:
  # Die produktive Codebasis wird niemals automatisch verändert.
  # Änderungen entstehen ausschließlich in einer isolierten Umgebung.
  workspace_directory: "data/evolution"
  # Änderungen werden erst nach Bestätigung übernommen.
  require_user_approval: true
  # Abhängigkeiten werden niemals automatisch installiert.
  auto_install_dependencies: false
  # Die allgemeine, automatische Evolution überträgt keinen Quellcode.
  allow_external_code_transfer: false
  live_development:
    enabled: true
    # Ausschließlich ein ausdrücklich gesprochener/geschriebener
    # Entwicklungsauftrag darf relevante Ausschnitte an den aktiven
    # Online-Codeanbieter senden. Im Offlinebetrieb bleibt alles lokal.
    allow_external_code_transfer: true
    max_files: 10
    max_context_characters: 100000
  # Schwellwerte der Codeanalyse.
  max_function_lines: 60
  max_module_lines: 500
  max_complexity: 12

# =============================================================================
# System: der Weg zurueck nach einem Neustart
# =============================================================================
system:
  # Womit AI-Orb sich selbst neu startet.
  #
  # Noetig wird das, sobald der Orb etwas an seinem eigenen Code aendert:
  # Python liest eine Moduldatei genau einmal, beim Import - ohne Neustart
  # haette er eine Datei geaendert, aber kein Programm.
  #
  # Leer lassen (Vorgabe): Der Startweg wird selbst gesucht. Bei der
  # installierten Fassung ist das "AI-Orb.exe" zwei Ebenen ueber dem
  # Programmordner, bei der Arbeitsfassung "ORB-STARTEN.bat" daneben.
  #
  # Nur eintragen, wer seine Installation eigenhaendig zurechtgelegt hat -
  # dann weiss der Eintrag besser als jede Suche, womit sie startet.
  # Findet AI-Orb keinen Weg, startet er sich NICHT neu: Lieber laufen
  # bleiben als nicht wiederkommen.
  restart_command: ""

# =============================================================================
# Sicherheitsschicht (Phase 8)
# =============================================================================
# Jede heikle Aktion laeuft hierueber. Was hier gesperrt ist, wird auch mit
# Zustimmung nicht ausgefuehrt.
security:
  # ---------------------------------------------------------------------------
  # Betriebsmodus
  # ---------------------------------------------------------------------------
  #   geschuetzt  Fragen, sperren, protokollieren. Die Vorgabe.
  #   offen       Alles erlaubt, nichts gefragt, keine Pfadsperren.
  #
  # "offen" ist eine ausdrueckliche Entscheidung, keine Bequemlichkeit. Der
  # Orb darf dann jede Datei auf jedem Laufwerk lesen und schreiben, seinen
  # eigenen Code aendern und Systembefehle ausfuehren - ohne dass du gefragt
  # wirst.
  #
  # Zwei Dinge bleiben auch dann bestehen, und zwar mit Absicht:
  #
  #   1. Das Pruefprotokoll unter data/security/audit.jsonl. Es kostet
  #      nichts, stoert nicht und ist hinterher das Einzige, was noch sagen
  #      kann, was geschehen ist.
  #   2. Die Sicherung vor Selbstaenderungen (siehe evolution). Ein Orb, der
  #      sich beim Umbau selbst zerlegt, kann sich nicht mehr reparieren -
  #      er laeuft ja nicht mehr.
  #
  # Beides laesst sich abschalten (audit_enabled, evolution.require_backup),
  # aber du solltest wissen, dass du es tust.
  mode: "offen"

  # Wie lange auf eine Antwort im Zustimmungsdialog gewartet wird.
  # Kommt keine, gilt das als Nein - Schweigen ist keine Zustimmung.
  # Im offenen Modus ohne Bedeutung, da nicht gefragt wird.
  consent_timeout_seconds: 120

  # Protokollieren, was der Orb tut. Auch im offenen Modus.
  audit_enabled: true

  # Berechtigungen, die niemals gewaehrt werden, auch nicht auf Nachfrage.
  # Im offenen Modus wird diese Liste nicht beachtet.
  never_allow: []

  # Berechtigungen, die ohne Rueckfrage gelten. Trage hier nur ein, was du
  # dauerhaft erlauben willst - jeder Eintrag ist eine Frage weniger, die
  # du siehst.
  # Im offenen Modus ohne Bedeutung. Fuer den geschuetzten Modus koennen
  # hier Berechtigungen stehen, die ohne Frage gelten.
  pre_approved:
    - "read_files"
    - "write_files"
    - "system_commands"
    - "screen_capture"
    - "microphone"
    - "internet"

  # Wie viele Zeilen das Pruefprotokoll hoechstens fuehrt.
  audit_max_entries: 5000

  # Biometrische Identitaet gehoert dem Betriebssystem. Der Orb fuehrt
  # keine eigene Gesichtsdatenbank und kennt weder Hello-Vorlage noch PIN.
  # Ist eine kompatible IR-Kamera vorhanden und Windows Hello eingerichtet,
  # entsperrt Windows selbst den Rechner. Der Orb darf diesen geschuetzten
  # Anmeldeweg niemals durch Kamera-Schnappschuesse oder simulierte
  # Passworteingaben umgehen.
  biometric_identity:
    provider: "windows_hello"
    windows_unlock: "os_managed"
    private_face_database: false
    password_injection: false

# =============================================================================
# Sprachsteuerung (Phasen 2, 4, 15)
# =============================================================================
voice:
  # Kurze Antworten halten den Dialog beweglich. Das lokale 8B-Modell
  # benoetigte mit 192 Tokens trotz fruehem ersten Satz insgesamt 14 s.
  # 40 Tokens reichen fuer eine kurze gesprochene Antwort und verhindern,
  # dass das lokale Modell bei mehreren Fragen in Folge immer langsamer wird.
  spoken_max_tokens: 40
  # Eine Vorlesung besteht aus mehreren gehaltvollen Abschnitten. Sie darf
  # deshalb nicht an der 40-Token-Grenze eines normalen Gespraechszugs
  # abgeschnitten werden. Nach jedem Abschnitt folgt ein kurzes Hoerfenster;
  # ohne Wortmeldung startet der naechste automatisch.
  vorlesung:
    # Genug Raum, damit eine angekuendigte feste Aufzaehlung nicht mitten
    # im dritten Punkt abbricht; weiterhin kurz genug fuer fluessige Sprache.
    abschnitt_max_tokens: 420
    pause_sekunden: 2.5
    max_abschnitte: 24
  # Gesamtschalter der Sprachsteuerung.
  enabled: true
  # Beim Start selbsttaetig zuhoeren. Es wird vorher nach dem Mikrofon gefragt.
  autostart: true
  # Hintergrundgespraeche erkennen.
  #
  # Im Nachfragefenster galt frueher JEDE Aeusserung als Anweisung. Am
  # 17.08.2026 stand deshalb im Protokoll, wie der Orb "Vielen Dank.",
  # "Die Kirchenweine und Schachtwaesche." und ganze Gespraechsfetzen aus
  # dem Raum verarbeitete - ein Fernseher, ein Gespraech nebenan, seine
  # eigene Lautsprecherstimme.
  #
  # Jetzt prueft er zuerst, ob er ueberhaupt gemeint ist: Name, Befehlsform,
  # Anrede in der zweiten Person, Frage - oder eben nicht. Im Zweifel
  # schweigt er und hoert weiter zu. Auf 'false' setzen, wenn er ausnahmslos
  # auf alles reagieren soll.
  hintergrund_erkennen: true

  # Wie lange der Orb nach einer Antwort noch ohne Weckwort zuhoert.
  #
  # Von 25 auf 45 erhoeht: Am 17.08. um 12:44:58 sagte der Benutzer klar
  # verstanden (0,92) "Suche meine Neuigkeiten zu neuen AI-Modellen" -
  # fuenf Sekunden nach Ablauf des Fensters. Der Orb schwieg, und das
  # wirkt wie ein Haenger. Wer eine Antwort anhoert und kurz nachdenkt,
  # braucht mehr als 25 Sekunden.
  follow_up_seconds: 45

  # Freie Ansprache: Die erkannte Stimme braucht KEIN Weckwort - weder
  # mitten im Gespraech noch fuer den ersten Satz. Der Orb kennt die
  # Stimme seines Benutzers (und von ihm zugelassene Gaststimmen) und
  # ist fuer sie immer ansprechbar. Voraussetzung ist eine hinterlegte
  # Stimme; ohne sie gilt weiter das Weckwort, sonst hoerte der Orb
  # wieder auf jeden. 'Das war's' schaltet ihn in Ruhe - dann holt ihn
  # nur das Weckwort zurueck. Gaststimmen: 'hoer auf diese Stimme'
  # zulassen, 'hoer nur auf mich' widerrufen.
  freie_ansprache: true
  # Aufhoeren zu sprechen, sobald der Benutzer beginnt (akustisch).
  #
  # Standardmaessig AUS. Grund: Der Lautsprecher spielt die Stimme des Orb
  # ab, das Mikrofon hoert sie mit, und ohne Echo-Unterdrueckung haelt der
  # Orb die eigene Stimme fuer ein Dazwischenreden - er unterbricht sich
  # selbst. Zum Unterbrechen dient stattdessen die Enter-Taste (siehe
  # interrupt_key), die dieses Problem nicht hat.
  #
  # Wer ein Headset benutzt (kein Echo zum Mikrofon), kann dies auf true
  # setzen und das akustische Dazwischenreden zusaetzlich nutzen.
  barge_in: false
  # Wie lange durchgehend gesprochen werden muss, damit es als
  # Unterbrechung gilt (Millisekunden). Nur wirksam bei barge_in: true.
  barge_in_hold_ms: 270
  # Gesprochene Woerter, die die Sprachausgabe abbrechen.
  #
  # Der Orb hoert waehrend des Sprechens darauf - sagst du "stop", haelt er
  # sofort an und hoert dir zu. Bewusst kurze, markante Woerter, damit der
  # Orb sie in seiner eigenen Antwort nicht versehentlich ausloest.
  stop_words:
    - "stop"
    - "stopp"
    - "halt"

  # Wie lang ein Hoerfenster ist, in dem der Orb waehrend des eigenen
  # Sprechens nach dem Stop-Wort horcht (Millisekunden).
  #
  # Die Fenster ueberlappen sich um die Haelfte. Kuerzer heisst schneller,
  # aber ein Wort passt dann womoeglich nicht mehr ganz hinein.
  # Am 19.08.2026 stand hier 1200. Das Fenster ist die halbe Miete:
  # Ein gerufenes "Stopp" dauert etwa 400 Millisekunden. In 1200 ms
  # Fenster macht es ein Drittel aus - der Rest ist der eigene
  # Lautsprecher, und die Erkennung schreibt auf, was ueberwiegt.
  # In 800 ms macht es die Haelfte aus. Bei halber Ueberlappung
  # (Sprung 400 ms) landet ein kurzer Ruf weiterhin sicher ganz in
  # mindestens einem Fenster.
  # 26.08.2026 von 800 auf 600: Im Protokoll standen 25 Hoerfenster, davon
  # 21 ohne jeden erkannten Text - das Fenster besteht waehrend des
  # Sprechens fast nur aus der eigenen Stimme aus dem Lautsprecher. Ein
  # gerufenes "Stopp" dauert etwa 400 ms; in 600 ms macht es zwei
  # Drittel aus statt der Haelfte. Bei halber Ueberlappung (Sprung
  # 300 ms) liegt ein kurzer Ruf weiterhin sicher ganz in einem Fenster.
  stop_window_ms: 600

  # Ob der Stop-Spaeher auch mithoert, waehrend die LOKALE Stimme spricht.
  #
  # Bis zum 26.08.2026 tat er das nicht - und damit war das Stop-Wort bei
  # dieser Einstellung vollstaendig wirkungslos. Der Grund war eine gut
  # gemeinte Ruecksicht: Supertonic erzeugt den naechsten Satz waehrend der
  # aktuelle laeuft, und Whisper daneben nimmt ihm die Rechenzeit. Die
  # Ruecksicht war richtig, ihre Reichweite falsch - sie galt fuer die ganze
  # Wiedergabe statt nur fuer die Erzeugung.
  #
  # Jetzt schweigt der Spaeher nur waehrend des Erzeugens. Waehrend des
  # Abspielens horcht er.
  #
  # Auf false gestellt kehrt das alte Verhalten zurueck. Dann ist der Orb
  # bei lokaler Stimme nur noch ueber voice.barge_in oder voice.interrupt_key
  # zu unterbrechen - stehen beide ebenfalls aus, sagt er es beim Start.
  stop_waehrend_lokaler_stimme: true

  # Der Anker fuer das kleine Modell, das NUR Weckwort und
  # Abbruchwort sucht.
  #
  # Absichtlich kurz und absichtlich ein anderer als
  # voice.input.initial_prompt: Ein Anker lenkt die Erkennung auf
  # das, was er nennt. Dem grossen Modell "Historiografie" und
  # "Bruttoinlandsprodukt" mitzugeben ist richtig - dem Spaeher,
  # der Schnipsel von unter einer Sekunde liest, nimmt es genau
  # die Woerter aus dem Sinn, auf die es hier ankommt.
  # Leer lassen faellt auf einen eingebauten Anker zurueck.
  # NICHT die Abbruchwoerter hineinschreiben.
  #
  # Am 19.08.2026 stand hier "Stopp. Halt. Warte. Hör auf." - und
  # der Orb hat sich daraufhin dauernd selbst unterbrochen. Der
  # Grund ist die Arbeitsweise von Whisper: Der Anker ist fuer das
  # Modell der Text unmittelbar VOR dem Fenster. Es setzt fort, was
  # dort steht. Auf einem undeutlichen Achtelsekundenschnipsel -
  # und das ist jedes Fenster, in dem der eigene Lautsprecher laeuft -
  # schreibt es dann bereitwillig "Stopp." hin. Der Anker hat die
  # Erkennung nicht geschaerft, sondern ihr das Wort soufflieren.
  #
  # Hier gehoert nur das Weckwort hinein: Danach wird gesucht, ohne
  # dass ein falscher Fund etwas kaputt macht - schlimmstenfalls
  # wacht der Orb einmal umsonst auf. Ein falsches "Stopp" dagegen
  # zerreisst jeden Satz.
  stop_initial_prompt: "Hallo Orb. Hey Orb."

  # Welches Whisper-Modell nur fuer das Stop-Wort zustaendig ist.
  #
  # Absichtlich ein anderes als voice.input.model_size: Das grosse Modell
  # braucht fuer ein Fenster ein bis drei Sekunden, die Fenster kommen aber
  # alle 600 Millisekunden. Es kaeme nie hinterher, und in den Luecken ginge
  # genau das "stop" verloren. Hier wird kein Satz verstanden, sondern auf
  # drei kurze Woerter gehorcht - dafuer genuegt "base".
  #
  # Faellt dieses Modell aus, uebernimmt das grosse. Dann kommt das "stop"
  # spaet, aber es kommt.
  stop_model_size: "base"

  # Taste, mit der die Sprachausgabe zusaetzlich unterbrochen wird.
  #
  # Leer = aus (Vorgabe): Zum Unterbrechen sagst du "stop". Wer lieber eine
  # Taste haette, traegt hier z. B. "Enter", "Escape" oder "Space" ein - sie
  # wird dann nur waehrend des Sprechens abgefangen.
  #
  # 26.08.2026 belegt mit "Escape". Der Grund ist nuechtern: Ueber offene
  # Lautsprecher kaempft das gesprochene Stop-Wort gegen die Physik. Das
  # Mikrofon hoert in erster Linie den Orb selbst; im Protokoll blieben 21
  # von 25 Hoerfenstern ohne erkannten Text. Daran aendert kein besseres
  # Modell etwas - das Nutzsignal ist einfach leiser als die Stoerung.
  #
  # Die Taste hat dieses Problem nicht. Sie ist nur waehrend des Sprechens
  # belegt und danach sofort wieder frei; ausserhalb der Sprachausgabe
  # gehoert Escape wieder dem Programm, in dem gerade gearbeitet wird.
  #
  # Mit Kopfhoerer statt Lautsprecher faellt das Echo weg. Dann greift auch
  # das gesprochene Stop-Wort zuverlaessig, und zusaetzlich kann
  # voice.barge_in auf true.
  interrupt_key: "Escape"
  # Der abkuerzende Fluss-Weg. Standardmaessig AUS - und du brauchst ihn
  # nicht mehr.
  #
  # Er redete direkt mit dem Sprachmodell und liess dabei die Denkschicht
  # aus: kein Geschichtsprofessor, keine Werkzeuge, kein Einordnen der
  # Absicht. Das war der Preis dafuer, frueh zu sprechen.
  #
  # Seit Fassung 0.5.0 ist dieser Preis nicht mehr faellig: Der gewoehnliche
  # Weg spricht jeden Satz, sobald er gedacht ist, UND behaelt die ganze
  # Denkschicht. Werkzeugaufrufe werden dabei zurueckgehalten - sie stehen
  # als eingezaeunter Block mitten in der Antwort und duerfen nie vorgelesen
  # werden.
  #
  # Dieser Schalter bleibt nur als Rueckfallebene bestehen. Wer ihn
  # einschaltet, bekommt wieder den abkuerzenden Weg - also weniger.
  stream_speech: false

  # ---------------------------------------------------------------------------
  # Auf wen der Orb hoert
  # ---------------------------------------------------------------------------
  # Das Mikrofon hoert alles: den Fernseher, ein Gespraech nebenan, eine
  # Videokonferenz. Ohne diese Pruefung ist dem Orb jede Stimme gleich viel
  # wert, und er nimmt Saetze als Anweisung entgegen, die niemand an ihn
  # gerichtet hat.
  #
  # Wirksam wird das erst, wenn eine Stimme hinterlegt ist. Sag dem Orb
  # "lern dir meine Stimme", dann fragt er ein paar Saetze ab. Mit
  # "vergiss meine Stimme" hoert er wieder auf jeden.
  #
  # Was das leistet und was nicht: Es erkennt zuverlaessig, dass eine
  # deutlich andere Stimme spricht. Es ist kein Stimmschloss - eine sehr
  # aehnliche Stimme oder eine starke Erkaeltung koennen es taeuschen.
  speaker:
    # Ob ueberhaupt geprueft wird. Ohne hinterlegte Stimme wirkungslos.
    enabled: true

    # Wie viele Saetze zum Lernen abgefragt werden.
    #
    # Mehrere sind noetig, nicht bloss nett: Aus einer einzigen Aufnahme
    # liesse sich nicht abschaetzen, wie sehr die eigene Stimme von Mal zu
    # Mal schwankt - und genau daraus entsteht die Erkennungsschwelle.
    enrollment_utterances: 3

    # Die Untergrenze der Erkennungsschwelle (0 bis 1).
    #
    # Hoeher = strenger, aber auch anfaelliger dafuer, die eigene Stimme
    # nicht mehr zu erkennen. Reagiert der Orb noch auf den Fernseher,
    # erhoehe diesen Wert in kleinen Schritten (0.60, 0.65 ...).
    min_similarity: 0.55

    # Die Obergrenze der Erkennungsschwelle.
    #
    # Klangen die Lernaufnahmen einander sehr aehnlich - etwa, weil sie
    # kurz nacheinander im selben Ton entstanden -, ergaebe die Rechnung
    # eine Schwelle, an der spaeter die eigene Stimme scheitert, sobald sie
    # muede, erkaeltet oder weiter weg ist. Dies ist die Decke der Strenge.
    #
    # Von 0.80 auf 0.55 gesenkt: Das Protokoll zeigte, dass der Orb die
    # eigene Stimme des Benutzers abwies ("Fremde Stimme ueberhoert",
    # Aehnlichkeit 0.62-0.79 gegen Schwelle 0.80). Die Lernaufnahmen waren
    # zu gleichfoermig, die Schwelle stand deshalb an der Decke - und die
    # Alltagsstimme kam nicht mehr durch. 0.55 laesst den Benutzer sicher
    # durch (er lag stets darueber) und weist eine wirklich fremde Stimme,
    # die meist deutlich tiefer liegt, weiter ab. Wer es strenger will,
    # lernt die Stimme mit "Stimme lernen" neu ein (mit etwas Abstand
    # zwischen den Proben) und hebt diesen Wert wieder an.
    max_threshold: 0.55

    # Wie viel Nachsicht unter der Aehnlichkeit der Lernaufnahmen bleibt.
    #
    # Groesser = nachsichtiger. Wer haeufig faelschlich ueberhoert wird,
    # erhoeht diesen Wert (0.10, 0.15).
    margin: 0.06

  # Klaenge, die den Zustand hoerbar machen.
  #
  # Der Orb zeigte bisher nur, dass er nachdenkt: rot, wirbelnder Nebel.
  # Wer gerade nicht hinsieht - und das ist bei einem Sprachassistenten die
  # Regel, sonst braeuchte man ihn nicht -, hoerte nach der Frage bloss
  # Stille und wusste nicht, ob sie angekommen ist.
  #
  # Ein kurzer Klang beantwortet das, ohne ein Wort zu kosten.
  sounds_enabled: true

  # Dazwischenreden beendet die Sprachausgabe.
  #
  # Sprichst du, waehrend der Orb spricht, hoert er auf - ganz gleich, was
  # du sagst. Du musst also nicht mehr "stop" rufen, sondern kannst einfach
  # anfangen zu reden, wie bei einem Menschen.
  #
  # Moeglich wird das erst durch die hinterlegte Stimme, und zwar aus einem
  # Grund, der vorher unueberwindbar war: Das Mikrofon hoert waehrend des
  # Sprechens vor allem den Orb selbst. Ohne zu wissen, WESSEN Stimme da
  # liegt, haette jede Silbe seiner eigenen Antwort ihn unterbrochen.
  #
  # Ohne hinterlegte Stimme bleibt es beim Stop-Wort.
  interrupt_on_speech: true

  # Wie viele Hoerfenster nacheinander fremde Worte enthalten muessen,
  # bevor der Wortvergleich die Antwort abbricht.
  #
  # Das ist die Einstellung gegen "der Orb unterbricht sich selbst".
  #
  # Der Wortvergleich arbeitet nicht auf sauberer Sprache, sondern auf dem,
  # was die Erkennung aus dem Echo der eigenen Stimme macht - und das ist
  # ein Text mit verhoerten und erfundenen Woertern. Ein einzelnes solches
  # Fenster genuegte, um mitten im Satz abzubrechen.
  #
  # Wer wirklich dazwischenredet, tut das laenger als ein Fenster (gut eine
  # Sekunde). Ein Verhoerer ist ein einmaliger Ausrutscher und im naechsten
  # Fenster wieder weg. Zwei Fenster trennen die beiden Faelle und kosten
  # dafuer knapp eine Sekunde.
  #
  #   1  ->  reagiert sofort, unterbricht sich aber gelegentlich selbst
  #   2  ->  Voreinstellung
  #   3  ->  sehr ruhig, aber traege beim Dazwischenreden
  #
  # Die Stimmerkennung bleibt davon unberuehrt: Erkennt sie deine Stimme,
  # bricht sie weiterhin sofort ab.
  interrupt_windows: 2

  # Wie sicher die Erkennung sein muss, damit ihr Text ueberhaupt als
  # Zwischenruf zaehlt (0.0 bis 1.0).
  #
  # Ein Hoerfenster mit dem Echo der eigenen Stimme wird schlecht erkannt,
  # weil es kein sauberes Sprachsignal ist. Genau dort erfindet die
  # Erkennung Woerter - und genau die sahen wie fremde Rede aus.
  interrupt_min_confidence: 0.45

  # Ab welcher Stimm-Aehnlichkeit ein Hoerfenster die LAUFENDE REDE abbricht
  # (0.0 bis 1.0). Bewusst HOCH und getrennt von der Sprecher-Akzeptanz.
  #
  # Der Grund: Waehrend der Orb spricht, ist sein eigenes Echo im Mikrofon.
  # Die Akzeptanzschwelle der Sprechererkennung wurde gesenkt, damit der Orb
  # die eigene Stimme des Benutzers zuverlaessig wiedererkennt - mit der
  # Nebenwirkung, dass schon das Echo als "Benutzer redet dazwischen" galt
  # und die Antwort mitten im Satz abbrach. Ein ABBRUCH verlangt darum eine
  # eigene, hohe Schwelle: erst wenn wirklich jemand deutlich ueber die Rede
  # spricht. Bricht der Orb dir immer noch zu frueh ab, erhoehe den Wert
  # (z.B. 0.88); willst du ihn leichter unterbrechen koennen, senke ihn.
  # 'stopp' und der Wortvergleich unterbrechen unabhaengig davon.
  barge_in_min_aehnlichkeit: 0.82

  # Nach dem Weckwort kurz bestaetigen, dass zugehoert wird.
  acknowledge_wake: true
  acknowledge_text: "Ja?"
  # Wie viele Gespraechsdurchgaenge im Verlauf bleiben.
  max_history: 50

  # --- Diktiermodus ----------------------------------------------------------
  # "Diktiere mir das Vorgehen zu X": Der Orb erstellt einen mitschreib-
  # gerechten Text, misst am Anfang an einem festen Satz dein Schreibtempo
  # und diktiert dann in Abschnitten, die dazu passen. Steuerworte waehrend
  # des Diktats: 'weiter', 'nochmal', 'langsamer', 'schneller', 'stopp'.
  diktat:
    # Wie lange (Sekunden) das Mitschreiben EINES Abschnitts etwa dauern
    # soll. Groesser = laengere Stuecke, seltener 'weiter'; kleiner =
    # kuerzere Stuecke, haeufiger. Dein gemessenes Tempo bestimmt daraus die
    # Zeichenzahl je Abschnitt.
    ziel_sekunden: 12

  wake_word:
    # Die Saetze, die den Orb wecken. Mehrere sind moeglich.
    #
    # "Orb" allein steht mit dabei, weil der Benutzer den Orb genau so
    # anspricht ("Orb, oeffne YouTube") - im Protokoll wurde jeder solche
    # Satz verstanden, aber nie ausgefuehrt, weil das Weckwort "Hallo Orb"
    # darin nicht vorkam. Und weil die Spracherkennung "Hallo Orb" haeufig
    # zu "ein weiter Orb" oder "weisser Orb" verhoert, in denen "Orb" aber
    # sauber steht, faengt "Orb" diese Faelle gleich mit. Dass davor bis zu
    # drei Woerter stehen duerfen (max_leading_words), verhindert, dass ein
    # "Orb" mitten im Satz weckt.
    phrases:
      - "Hallo Orb"
      - "Hey Orb"
      - "Orb"
    # Dauerhaft auf das Weckwort hoeren. Solange es nicht faellt, wird
    # nichts weitergegeben und nichts gespeichert.
    always_on: true
    # Ab welcher Aehnlichkeit ein Treffer gilt (0.0 bis 1.0). Hoehere Werte
    # bedeuten strengere Erkennung.
    threshold: 0.78
    # Wie viele Woerter vor dem Weckwort stehen duerfen.
    max_leading_words: 3

  input:
    # Whisper-Modellgroesse: tiny | base | small | medium | large-v3
    #
    # Frueher stand hier "small" mit der Begruendung, "base" verhoere
    # sich auf Deutsch deutlich oefter und die Mehrzeit sei ein
    # Wimpernschlag. Das erste stimmt weiterhin. Das zweite galt fuer
    # den Betrieb am Rechner, wo man nebenher weiterarbeitet - nicht
    # fuer den Betrieb vom iPad aus, wo man auf jede Antwort wartet und
    # nichts anderes tut.
    #
    # Wer die Genauigkeit braucht, traegt "small" wieder ein; wer eine
    # schnelle Maschine hat, "medium" (1,5 GB, spuerbar langsamer).
    # Zurueck auf "small" (27.08.2026, nachmittags).
    #
    # "base" war fuer einen Nachmittag eingetragen, um Wartezeit zu
    # sparen. Der Versuch ist gescheitert, und zwar eindeutig. Aus
    # "Nachrichten aus aller Welt" wurde der Reihe nach:
    #
    #   "Fahre fort mit den Jungs, also an der Welt"
    #   "Petra geht mit den News aus aller Welt"
    #   "Passen mit die Nachrichten aus alle Welt zusammen"
    #   "Gib mir die Nachrichten aus allen Weltbitten"
    #
    # Der Orb hat diese Saetze brav beantwortet. Von aussen sieht das
    # aus, als erfinde er etwas - dabei hat er nur getan, was er
    # verstanden hat. Ein Assistent, der schnell das Falsche tut, ist
    # schlimmer als einer, der langsam das Richtige tut.
    #
    # Die Wartezeit kam ohnehin von woanders: Die Aufnahme lief bis zur
    # Obergrenze und war zu drei Vierteln Stille. Seit sie von selbst
    # endet und die Stille weggeschnitten wird, rechnet auch "small"
    # ueber wenige Sekunden statt ueber dreissig.
    model_size: "small"
    language: "de"
    # cpu | cuda | auto
    device: "auto"
    compute_type: "int8"
    # Rechenkerne fuer die Spracherkennung. 0 heisst: selbst bestimmen
    # (alle Kerne bis auf einen). faster-whisper nimmt sonst genau vier,
    # gleichgueltig wie viele der Rechner hat - die Messung vom 16.08.2026
    # zeigt die Erkennung bei 5,2 Sekunden im Median, fast reine Rechenzeit.
    cpu_threads: 0
    # 2 statt 1: Whisper wagt einen zweiten Deutungsversuch je Wort.
    # Merklich genauer bei Dialekt und Nebengeraeuschen, kaum langsamer.
    # Wie viele Moeglichkeiten gleichzeitig verfolgt werden.
    #
    # Hoeher heisst genauer und langsamer. Von 2 auf 5 kostet je Aeusserung
    # einige Zehntelsekunden und faengt genau die Faelle ab, in denen die
    # erste Vermutung knapp danebenliegt - also die, bei denen man denkt,
    # er habe nicht zugehoert.
    beam_size: 5

    # Der Anfangshinweis fuer die Spracherkennung.
    #
    # Das ist der billigste Hebel, den es hier gibt, und er kostet keine
    # Rechenzeit. Whisper bedingt seine Ausgabe auf diesen Text, als waere
    # er das, was unmittelbar davor gesagt wurde. Ohne ihn raet es
    # Fachbegriffe und Eigennamen nach dem, was im Deutschen allgemein
    # haeufig ist: "Hallo Orb" wird zu "Hallo Robert", "Historiografie" zu
    # "Historio Grafie".
    #
    # Hier gehoeren die Woerter hinein, die DU oft sagst und die selten
    # sind: dein Weckwort, deine Fachbegriffe, Namen. Ausgegeben wird der
    # Text nie.
    initial_prompt: >-
      Ein Gespraech mit AI-Orb, einem deutschsprachigen Assistenten.
      Haeufige Woerter: Hallo Orb, Hey Orb, stopp, Bildschirm, Datei,
      Ordner, Browser, Programm starten, Mail, Termin, Notiz, Tagebuch,
      Tagebucheintrag. Erstelle einen neuen Tagebucheintrag. Beginne jetzt
      mit dem Diktieren. Ende des Eintrages.
      Fachgebiete: Geschichtswissenschaft, Historiografie, Quellenkritik,
      Politikwissenschaft, Voelkerrecht, Diplomatie, Archivarbeit,
      Sekundaerliteratur, militaerische Konflikte, Geopolitik.
      Philosophie, Ethik, Erkenntnistheorie, Metaphysik, Sokrates, Platon,
      Aristoteles, Kant. Linguistik, Sprachwissenschaft, Phonetik, Phonologie,
      Morphologie, Syntax, Semantik, Pragmatik. Germanistik,
      Literaturwissenschaft, Literaturgeschichte, Goethe, Schiller, Kafka.
      Kuenstliche Intelligenz, Sprachmodell, Algorithmus, Datensatz,
      Regulierung. Volkswirtschaft, Inflation, Leitzins, Lieferkette,
      Bruttoinlandsprodukt, Ungleichheit.
    # Mikrofon; leer lassen fuer das Standardgeraet.
    microphone: null
    # Wie viel vor dem erkannten Sprachbeginn mitgespeichert wird.
    preroll_ms: 400
    # Wie lange Stille eine Aeusserung beendet.
    silence_ms: 900
    # Empfindlichkeit der Sprachaktivitaetserkennung.
    threshold_factor: 3.0
    minimum_speech_ms: 350
    max_utterance_seconds: 20
    # Unter dieser Verlaesslichkeit wird nachgefragt statt geraten.
    min_confidence: 0.35

    min_characters: 2

    # Unter dieser Sicherheit fragt der Orb nach, statt zu antworten.
    #
    # Der Anlass steht im Protokoll: Von vierzehn erkannten Aeusserungen
    # lagen acht unter 0.90, und mehrere waren Kauderwelsch - "Forte Forte,
    # Dein Landtort", "Kommst du die Suche der Politen irgendwie?".
    #
    # Das Schlimme daran ist nicht die Fehlerkennung. Es ist, dass der Orb
    # DARAUF ANTWORTET: Er bekommt einen Satz, den nie jemand gesagt hat,
    # denkt darueber nach und redet - und du haeltst IHN fuer kaputt.
    #
    # Ein Mensch fragt in so einem Fall nach. Kurze Aeusserungen und das
    # Stop-Wort sind ausgenommen: Sie werden oft unsicher erkannt, und dort
    # ist der Schaden klein.
    #
    #   0.70  ->  fragt selten nach, laesst mehr Unsinn durch
    #   0.78  ->  Voreinstellung
    #   0.85  ->  fragt oft nach; nur sinnvoll bei schwierigem Mikrofon
    rueckfrage_unter: 0.78
    rueckfrage_text: "Das habe ich nicht sicher verstanden. Sagst du es noch einmal?"

  output:
    # Der Klang, der beim Nachdenken erklingt.
    #
    # LEER, auf ausdruecklichen Wunsch des Benutzers (20.08.2026:
    # "ein neuer Ton ist implementiert worden, entferne diesen
    # wieder"). Er war am 19.08. eingebaut worden, weil zwischen
    # Frage und erstem Wort im Median 6,4 Sekunden Stille lagen -
    # aber ein Ton vor JEDER Antwort ist nach einem Tag keine
    # Auskunft mehr, sondern Geraeusch. Dass der Orb nachdenkt,
    # zeigt weiterhin die Farbe.
    #
    # Wer ihn zurueckwill, traegt hier wieder "audio/denken.wav" ein;
    # die Datei liegt weiterhin bei.
    thinking_sound: ""

    # Der Klang, der ertoent, sobald der Orb zuzuhoeren beginnt - also nach
    # dem Weckwort. Er ist die hoerbare Antwort darauf: Ohne ihn beginnt man
    # zu sprechen und weiss erst hinterher, ob ueberhaupt jemand zugehoert
    # hat.
    listening_sound: "audio/zuhoeren.wav"

    # Der Klang, wenn der Orb etwas TUT statt sagt: ein Programm starten,
    # eine Seite oeffnen, etwas installieren, eine Datei schreiben.
    #
    # Er gilt nicht fuer jedes Werkzeug. Die Uhrzeit abzulesen oder zu
    # rechnen gehoert zur Antwort; da waere ein Ton bald nur noch Laerm.
    # Er ertoent bei den Berechtigungen launch_application,
    # install_dependencies, system_commands, write_files und
    # modify_own_code - also ueberall dort, wo sich der Rechner aendert
    # und nicht bloss das Gespraech.
    action_sound: "audio/aktion.wav"

    # Der Klang beim Hochfahren: "Ich bin da."
    #
    # Er kommt, wenn der Kern wirklich bereit ist, nicht wenn das Fenster
    # erscheint. Ein Klang, der zu frueh ertoent, verspricht etwas, was
    # noch nicht gilt.
    startup_sound: "audio/start.wav"
    enabled: true
    # Genau EINE feste Stimme. Ein technischer Fehler darf nicht mitten in
    # einer Antwort eine andere Klangfarbe einschalten.
    engines:
      - "supertonic"
    # Online und Offline benutzen absichtlich dieselbe lokale Stimme.
    offline_engines:
      - "supertonic"
    # Innerhalb einer Sitzung bleibt dieselbe funktionierende Engine aktiv.
    # Ein Provider- oder Netzstatusereignis darf keinen Satz mit einer anderen
    # Stimme fortsetzen.
    consistent_voice: true
    # Kein lautloser Wechsel auf Pocket, ElevenLabs, Piper oder Windows. Wenn
    # diese Stimme ausnahmsweise scheitert, wird die Ausgabe beendet und der
    # Fehler angezeigt; der naechste Auftrag versucht dieselbe Persona erneut.
    allow_voice_fallback: false
    # Sprechgeschwindigkeit und Lautstaerke (1.0 ist normal).
    # Supertonic M1 spricht bei Normaltempo klar und lebendig.
    speed: 1.0
    volume: 1.0
    # Ausdruck verändert Tempo und Tonhöhe, nicht die wahrgenommene
    # Lautstärke. Zusätzlich werden getrennt erzeugte Sätze beim Abspielen
    # auf einen gemeinsamen, moderaten RMS-Pegel gebracht.
    stable_volume: true
    normalize_volume: true
    # Etwa -20 dBFS aktive Sprachlautheit: klar, aber mit ausreichend
    # Spitzenreserve. Pausen werden bei der Messung nicht mitgerechnet.
    target_rms: 0.10
    # ElevenLabs liefert pro Datei eigene Randstille. Sie wird auf einen
    # kleinen, einheitlichen Atemrand gekuerzt; Pausen INNERHALB der Rede
    # bleiben unangetastet.
    trim_boundary_silence: true
    leading_silence_ms: 30
    trailing_silence_ms: 70
    # Nur fuer sehr lange, intern zerlegte Ausgaben. Beim Satz-Streaming
    # entsteht der Atemrand bereits in den WAV-Dateien.
    sentence_pause_ms: 60
    # Menschlicher Sprechrhythmus ohne wiederkehrenden gesprochenen Vorspann.
    # Tempo/Pausen duerfen sich weiterhin behutsam an die lokal gelernte
    # Benutzerstimme anpassen; automatische Fuellsaetze bleiben aus.
    human_timing:
      enabled: true
      fillers_enabled: false
      # Nur relevant, falls Fuelllaute spaeter bewusst aktiviert werden.
      filler_cooldown_seconds: 120
      minimum_words: 9
      adapt_to_user_rhythm: true
    # Gefuehlslage der Stimme aus Zustand und Text ableiten.
    emotions_enabled: true
    # Erzeugte Sprache wiederverwenden, statt sie neu zu berechnen.
    cache_enabled: true
    # Einen ausgefallenen Sprachserver nicht fuer jeden einzelnen Satz erneut
    # aufrufen. Nach Ablauf wird er automatisch wieder ausprobiert.
    failure_cooldown_seconds: 90
    # Ab welcher Laenge eine Antwort in Abschnitte zerlegt wird.
    # Ganze Gedanken erhalten: Zu kurze Schnitte mitten im Satz zerstoeren
    # Betonung und Verstaendlichkeit. Supertonic verarbeitet bis etwa 300
    # Zeichen je Abschnitt stabil; der Folgesatz wird parallel vorbereitet.
    max_characters: 260
    # Was beim Vorwaermen gesprochen wird.
    warmup_text: "Bereit."

    supertonic:
      # 99-M-Parameter-ONNX-Modell, 44,1 kHz, vollstaendig lokal. M1 ist die
      # klare, lebendige Maennerstimme fuer direkte Erklaerungen; sie bleibt
      # fuer jeden Zustand und in jedem Betriebsmodus dieselbe.
      model: "supertonic-3"
      voice: "M1"
      language: "de"
      # Sechs Schritte sind hier der beste Punkt zwischen Klang und Dialog:
      # derselbe schwierige Testsatz blieb vollstaendig verstaendlich, ein
      # kurzer Satz fiel aber von 2,73 auf 1,95 Sekunden Erzeugungszeit.
      steps: 6
      cpu_threads: 6
      chunk_silence_ms: 70

    pocket_tts:
      # Nur noch als inaktive Vergleichsengine im Code vorhanden. Sie ist
      # bewusst NICHT in engines/offline_engines: Unter Last wurde Deutsch
      # undeutlich und ihr Timeout loeste die beanstandeten Stimmwechsel aus.
      # Das deutsche Echtzeitmodell ist auch unter der Last des vollstaendigen
      # Orb schneller als die Wiedergabe. Die 24-Layer-Variante klingt eine
      # Spur feiner, fiel in diesem CPU-Prozess aber auf 0,39x Echtzeit und
      # erzeugte dadurch Pausen mitten in der Rede. Fluessigkeit gewinnt.
      model_variant: "german"
      # Frei verfuegbare deutsche Katalogstimme. Der Stimmenzustand und alle
      # Modellgewichte liegen lokal; im Betrieb gibt es keinen Netzaufruf.
      voice: "juergen"
      # Dynamische INT8-Quantisierung senkt Speicherbedarf und Latenz. Laut
      # Pocket-TTS-Dokumentation bleibt die Wortfehlerrate dabei unveraendert.
      quantize: true
      temperature: 0.70
      sampler_decode_steps: 1
      eos_threshold: -4.0
      max_tokens: 50
      streaming: true
      # 600 ms Vorsprung verhindern Aussetzer, wenn Whisper und Oberfläche
      # kurz CPU-Zeit benötigen; der erste Ton bleibt klar unter einer Sekunde.
      prebuffer_ms: 600
      first_chunk_timeout: 15

    piper:
      # Deutsche Stimmen, von fluessig nach genuegsam:
      #
      #   de_DE-thorsten-high      groesstes Modell, deutlich weicher und
      #                            weniger blechern. Voreinstellung.
      #   de_DE-thorsten-medium    schneller, hoerbar kaerger
      #   de_DE-thorsten-low       nur fuer schwache Rechner
      #   de_DE-eva_k-x_low, de_DE-kerstin-low, de_DE-ramona-low  (weiblich)
      #   de_DE-karlsson-low
      #
      # "high" ist die natuerlichste lokale deutsche Stimme. Sie braucht
      # etwas mehr Rechenzeit je Satz, aber die Luecken zwischen den Saetzen
      # sind ohnehin verschwunden (der naechste Satz wird vorbereitet,
      # waehrend der aktuelle laeuft). Wer einen sehr langsamen Rechner hat,
      # nimmt "de_DE-thorsten-medium".
      #
      # Wirklich natuerlich (wie ein Mensch) wird es nur mit einer
      # Cloud-Stimme - siehe den Abschnitt speechgen weiter unten.
      voice: "de_DE-thorsten-high"
      models_directory: "models/piper"

    openvoice_clone:
      # Autorisierte Referenz aus der aktuell gewaehlten ElevenLabs-Stimme.
      reference_audio: "data/voice/orb-reference.wav"
      # Einmal erzeugte deutsche Piper-Referenz fuer die Quell-Klangfarbe.
      source_reference: "data/voice/piper-source-reference.wav"
      source_directory: "runtime/openvoice-source"
      base_voice: "de_DE-thorsten-high"
      # OpenVoice-Standardwert. Erhaelt die Ziel-Klangfarbe, ohne die
      # Artikulation der deutschen Basisstimme unnoetig zu verwischen.
      tau: 0.30

    edge_neural:
      # Neue mehrsprachige deutsche Stimme; weicher und weniger nach
      # klassischer Vorlesestimme als Conrad/Killian.
      voice: "de-DE-FlorianMultilingualNeural"
      # Leicht vorwaerts, aber nicht gehetzt. Die Gefuehlslage darf das
      # Tempo und die Tonhoehe pro Satz in engem Rahmen variieren.
      rate_percent: 2
      pitch_hz: 0
      # Ohne Netz nach spaetestens vier Sekunden zum lokalen Klon wechseln.
      timeout_seconds: 4

    openai_tts:
      model: "gpt-4o-mini-tts"
      # Cedar ist die ruhige, tragfaehige Mentor-Stimme. Der Klang ist
      # eingebaut; das spontane Verhalten kommt aus der Regieanweisung.
      voice: "cedar"
      api_key_env: "OPENAI_API_KEY"
      timeout: 25
      instructions: >-
        Sprich auf Deutsch wie ein spontaner, intelligenter Mensch in einem
        direkten Gespraech. Natuerlich, warm, praesent und praezise. Du bist
        ein erstklassiger Mentor und Professor, aber ohne akademisches Gehabe.
        Klinge locker und reagiere unmittelbar, nicht wie ein Lehrbuch,
        Nachrichtensprecher, Hoerbuch oder Kundendienst. Variiere Satzmelodie,
        Rhythmus und Tempo unaufdringlich. Kurze Saetze und Satzfragmente
        duerfen impulsiv klingen. Setze kleine natuerliche Pausen nur an
        Sinnstellen; nie lange, dramatische oder gleichfoermige Pausen. Ein
        trockenes, leicht ironisches Schnauben oder kurzes Lachen darf hoerbar
        werden, wenn der Text es wirklich traegt, aber nie als Ritual. Keine
        uebertriebene Freundlichkeit, kein Schauspiel und kein Roboterklang.

    chatterbox:
      # Autorisierte Referenz aus einer aktuellen ElevenLabs-Ausgabe.
      reference_audio: "data/voice/orb-reference.wav"
      language: "de"
      device: "auto"
      # V3 verbessert laut Hersteller Sprecherähnlichkeit, Natürlichkeit
      # und Stabilität gegenüber dem zuvor tatsächlich geladenen V2-Modell.
      model_variant: "v3"
      # Etwas ruhiger und naeher an der sachlichen Orb-Stimme als die
      # ausdrucksstarken Chatterbox-Standardwerte.
      exaggeration: 0.50
      cfg_weight: 0.45
      temperature: 0.72
      repetition_penalty: 1.2
      min_p: 0.05
      top_p: 1.0
      # Chatterbox selbst setzt pauschal 1.000 Tokens. Ein selten verfehltes
      # Satzende blockiert auf CPU dann mehrere Minuten. Orb berechnet eine
      # Textlaengen-Grenze und kappt sie an dieser sicheren Obergrenze.
      max_new_tokens: 280
      tokens_per_character: 2.4
      token_margin: 32
      # Lebendigkeit der Stimme. Hoehere Werte klingen weniger monoton,
      # aber zu hoch wird die Aussprache hastig und undeutlich.
      # noise_w gibt Rhythmus (Schwankung der Lautlaengen), noise_scale gibt
      # Ausdruck (Schwankung im Klang). 0.8 / 0.667 sind die Werte, mit
      # denen Thorsten-high trainiert wurde - dort spricht er am klarsten.
      noise_w: 0.8
      noise_scale: 0.667

    sapi:
      # Leer lassen: AI-Orb waehlt dann die erste deutsche Windows-Stimme.
      voice: ""
      timeout: 60

    kokoro:
      voice: "af_heart"
      language: "en"

    # Die authentische Stimme ueber ElevenLabs (Netz, Schluessel noetig).
    #
    # Deutlich natuerlicher als die lokalen Stimmen UND schneller als das
    # grosse Piper-Modell, weil im Netz erzeugt. Der Preis: Der zu
    # sprechende Text geht an einen fremden Server - eine bewusste Wahl,
    # keine Voreinstellung.
    #
    # So schaltest du sie ein:
    #   1. ELEVENLABS_API_KEY in die .env eintragen
    #   2. hier eine voice_id setzen (z. B. die von "Miles" aus deinem
    #      ElevenLabs-Konto)
    #   3. "elevenlabs" oben in voice.output.engines an die erste Stelle
    #      setzen
    # Ohne Schluessel bleibt sie still und Piper uebernimmt.
    elevenlabs:
      # Die gewaehlte Stimme des Benutzers.
      #
      # Steht hier eine Kennung, wird die Stimmenliste gar nicht erst
      # abgefragt - das spart einen Netzaufruf je Sitzung und funktioniert
      # auch mit einem Schluessel, der nur sprechen, aber nichts lesen darf.
      # Leer lassen heisst: selbst suchen (siehe elevenlabs_engine.py).
      # Vom Benutzer ausgewaehlte ElevenLabs-Stimme.
      voice_id: "aV6RoO53eIRcDLcrLZpr"
      # Flash v2.5 ist ElevenLabs' Echtzeitmodell fuer deutsche
      # Sprachassistenten. Es behaelt die ueber voice_id gewaehlte Stimme,
      # beginnt aber deutlich schneller als das inzwischen ueberholte Turbo.
      # Fuer maximale Langform-Nuance bleibt "eleven_multilingual_v2" eine
      # Option, ist im direkten Gespraech jedoch merklich langsamer.
      model: "eleven_flash_v2_5"
      # Sachlich und sicher statt dramatisch zoegernd. Eine niedrige
      # Stabilitaet und hohe Stilueberzeichnung erzeugten zuvor mitten im
      # Satz Pausen von bis zu rund 0,8 Sekunden.
      stability: 0.58
      similarity_boost: 0.85
      style: 0.0
      use_speaker_boost: true
      api_key_env: "ELEVENLABS_API_KEY"

    # SpeechGen.io - fluessige, natuerliche Cloud-Stimme (Schluessel noetig).
    #
    # So schaltest du sie ein:
    #   1. SPEECHGEN_TOKEN und SPEECHGEN_EMAIL in die .env eintragen
    #      (aus deinem SpeechGen-Konto unter "API")
    #   2. hier den Namen der gewuenschten deutschen Stimme setzen, z. B.
    #      eine der deutschen Stimmen aus der SpeechGen-Stimmenliste
    #   3. "speechgen" oben in voice.output.engines an die erste Stelle
    #      setzen
    # Ohne Zugangsdaten bleibt sie still und Piper uebernimmt. Der Text geht
    # dabei an SpeechGens Server.
    speechgen:
      voice: ""
      token_env: "SPEECHGEN_TOKEN"
      email_env: "SPEECHGEN_EMAIL"

    # Eigener TTS-Server (z. B. Chatterbox Multilingual V3 auf einer GPU).
    #
    # Ausdrucksstarke neuronale Stimmen sind auf einem gewoehnlichen Rechner
    # zu langsam. Deshalb laeuft das Modell auf einer GPU (Colab oder Server),
    # und AI-Orb
    # ruft es uebers Netz. Wie man den Server startet, steht in
    # docs/STIMME_CSM.md und unter server/.
    #
    # endpoint: die Adresse deines Servers (z. B. eine Colab-Tunnel-URL).
    #           Leer = aus, dann uebernimmt Piper.
    # Ein optionaler Zugangstoken kommt in die .env (REMOTE_TTS_TOKEN).
    remote:
      # Cloudflare-Tunneladressen sind nur fuer die jeweilige Colab-Sitzung
      # gueltig. Eine abgelaufene Adresse hier bremst jeden ersten Satz.
      endpoint: ""
      token_env: "REMOTE_TTS_TOKEN"
      speaker: 0
      timeout: 60

# =============================================================================
# Werkzeuge (Phase 9)
# =============================================================================
# =============================================================================
# Recherche: mehrere Quellen statt eines besten Treffers
# =============================================================================
# Der Benutzer fragte, ob der Orb auch andere Berichterstattung einbezieht -
# Al Jazeera etwa. Vorher: nein. Nicht weil etwas gesperrt gewesen waere,
# sondern weil niemand danach fragte. Der Orb las, was in der Trefferliste
# oben stand, und das ist bei deutschsprachigen Fragen fast immer
# tagesschau oder zdfheute.
#
# Wer wissen will, wie ueber einen Konflikt BERICHTET wird, braucht nicht
# den besten Treffer, sondern mehrere Darstellungen nebeneinander - und den
# Hinweis, wo sie auseinandergehen. Der beste Treffer leistet das nicht: Er
# ist eine Sicht, die sich als die Sache ausgibt.
recherche:
  # Mehrere Haeuser parallel befragen, wenn es um Aktuelles geht.
  mehrquellen: true

  # Wie viele Treffer je Haus. Drei genuegen, um die Stossrichtung zu
  # erkennen; mehr blaehen nur den Kontext auf.
  treffer_je_quelle: 3

  # Wie viele Anfragen gleichzeitig laufen duerfen.
  #
  # Nicht hochsetzen. Acht Anfragen im selben Augenblick haelt jede
  # Suchmaschine fuer einen Angriff - dann kommt gar nichts zurueck.
  gleichzeitig: 4

  # Die Haeuser. Bewusst ueber Sprachraeume verteilt: Eine Nachricht aus
  # Doha ist anders gerahmt als dieselbe aus London oder Zuerich, und
  # genau dieser Unterschied ist die Auskunft.
  #
  # 'feed' ist die RSS-Titelseite des Hauses. Sie wird DIREKT gelesen -
  # ohne Suchmaschine, und damit ohne die Abweisungen, an denen die
  # Nachrichtenrunde am 16.08.2026 gescheitert ist. 'einschraenkung'
  # bleibt als Tiefensuche fuer Themen, die von der Titelseite schon
  # verschwunden sind.
  #
  # Reuters ist nicht mehr dabei: Das Haus hat seine oeffentlichen Feeds
  # 2020 eingestellt. Dafuer NPR aus den USA - der Sprachraum fehlte.
  quellen:
    - {name: "tagesschau (DE)",    einschraenkung: "site:tagesschau.de",
       feed: "https://www.tagesschau.de/index~rss2.xml"}
    - {name: "NZZ (CH)",           einschraenkung: "site:nzz.ch",
       feed: "https://www.nzz.ch/recent.rss"}
    - {name: "BBC (UK)",           einschraenkung: "site:bbc.com",
       feed: "https://feeds.bbci.co.uk/news/world/rss.xml"}
    - {name: "Al Jazeera (QA)",    einschraenkung: "site:aljazeera.com",
       feed: "https://www.aljazeera.com/xml/rss/all.xml"}
    - {name: "Le Monde (FR)",      einschraenkung: "site:lemonde.fr",
       feed: "https://www.lemonde.fr/rss/une.xml"}
    - {name: "NPR (US)",           einschraenkung: "site:npr.org",
       feed: "https://feeds.npr.org/1001/rss.xml"}

  # --- Die eigenen Favoriten als Rechercheziel ------------------------------
  #
  # Die Favoritenleiste eines Wissenschaftlers ist seine ueber Jahre
  # gesammelte Quellensammlung. Bisher konnte der Orb darin nur die
  # LESEZEICHEN durchsuchen - Titel, Adresse, Ordnername. Was auf diesen
  # Seiten steht, blieb ihm verschlossen: Aus einem Archivportal in der
  # Leiste wurde ein Link, keine durchsuchbare Quelle.
  #
  # Jetzt zieht er die Domaenen aus den Favoriten und sucht gezielt DARIN.
  favoriten:
    # Bei Fachfragen zuerst in den eigenen Quellen suchen.
    nutzen: true
    # Nur Favoriten aus diesem Ordner (leer = alle).
    #
    # Empfohlen: einen Ordner anlegen und die wissenschaftlichen Quellen
    # hineinlegen. Sonst landen auch der Onlineshop und das Kochrezept in
    # der Recherche.
    ordner: ""
    # Wie viele verschiedene Domaenen hoechstens befragt werden.
    max_domaenen: 4
    # Wie viele Treffer je Domaene.
    treffer_je_domaene: 3

tools:
  enabled: true
  # Wie oft das Modell hoechstens ein Werkzeug aufrufen darf, bevor es
  # abschliessend antworten muss. Verhindert Endlosschleifen.
  max_rounds: 4
  # Wie viel Werkzeugausgabe hoechstens an das Modell zurueckgeht.
  max_output_characters: 4000

# =============================================================================
# Browsersteuerung
# =============================================================================
# Der Orb bedient ein echtes Browserfenster - scrollen, klicken, tippen,
# Formulare. Getragen von Playwright. Einmalig einzurichten mit
# BROWSER-EINRICHTEN.bat (installiert Playwright und den Browser). Erst dann
# steht das Werkzeug 'browser_bedienen' wirklich zur Verfuegung; vorher meldet
# es ruhig, dass die Einrichtung fehlt.
browser:
  enabled: true

  # Ein EIGENES, dauerhaftes Profil. Wer sich darin einmal irgendwo anmeldet,
  # ist beim naechsten Mal noch angemeldet - wie in einem normalen Browser.
  # Der Orb sieht dabei nie ein Passwort; es bleibt im Profil des Browsers.
  # Leer lassen = Vorgabe (models/browser-profil im Projektordner).
  profil_pfad: ""

  # Das Fenster sichtbar zeigen (true) oder unsichtbar im Hintergrund (false).
  # Sichtbar ist ehrlicher: Man sieht, was der Orb tut, und kann eingreifen.
  sichtbar: true

  # Welcher Browser. "chrome" nimmt das installierte Google Chrome (mit deinen
  # gewohnten Anmeldungen erreichbar, sobald du dich im Orb-Profil anmeldest).
  # Leer = der von Playwright mitgelieferte Chromium.
  kanal: "chrome"

  # Statt eines eigenen Profils an ein SCHON LAUFENDES Chrome anhaengen, das
  # mit --remote-debugging-port gestartet wurde. Fuer Fortgeschrittene; leer
  # lassen, dann nimmt der Orb sein eigenes Profil.
  cdp_url: ""

  # Wie lange (in Millisekunden) auf ein Element gewartet wird, bevor eine
  # Aktion als gescheitert gilt.
  zeitlimit_ms: 15000

# =============================================================================
# Google Kalender
# =============================================================================
# Termine ansehen, anlegen, aendern, loeschen - und von sich aus an
# anstehende erinnern.
#
# Die Anmeldung ist DIESELBE wie bei Gmail: dieselbe GMAIL_CLIENT_ID aus der
# .env, dasselbe Token, eine Zustimmungsseite fuer beides. Wer Gmail schon
# eingerichtet hat, muss sich nur einmal neu anmelden - das alte Token
# kannte den Kalender noch nicht. Dazu sagen: "Melde mich bei Gmail an".
kalender:
  enabled: true

  # Verbindliche Ortszeit fuer Sprachbefehle, Google-Abfragen und Anzeige.
  # Explizite IANA-Zonen behandeln Sommer- und Winterzeit korrekt; die
  # Windows-Systemzone wird nicht mehr stillschweigend erraten.
  # Der verbundene Google-Hauptkalender meldet Europe/Zurich. Berlin haette
  # zwar dieselben DST-Regeln, aber der exakte Abgleich vermeidet Zweideutigkeit.
  zeitzone: "Europe/Zurich"

  # Welcher Kalender. "primary" ist der Hauptkalender des angemeldeten
  # Kontos. Fuer einen anderen hier dessen Kennung eintragen (steht in den
  # Google-Kalendereinstellungen unter "Kalender-ID").
  kalender_id: "primary"

  erinnerung:
    # Der Orb sagt von sich aus Bescheid, bevor ein Termin ansteht.
    enabled: true

    # Wie viele Minuten vorher erinnert wird. Mehrere Werte ergeben mehrere
    # Erinnerungen je Termin - eine zur Vorbereitung, eine zum Aufbrechen.
    # Ganztaegige Termine bleiben aussen vor: Bei ihnen gibt es keine
    # Uhrzeit, auf die sich ein Vorlauf beziehen koennte.
    vorlaufzeiten: [60, 10]

    # Wie oft nachgesehen wird, in Sekunden. Haeufiger als der kleinste
    # Vorlauf zu schauen ist noetig, sonst wird eine Erinnerung verpasst.
    takt_sekunden: 180

# =============================================================================
# Plugins (Phase 6)
# =============================================================================
plugins:
  directory: "plugins"
  # Vor dem Laden fragen. Ein Plugin ist fremder Programmcode.
  require_confirmation: true
  # Plugins mit "enabled: true" beim Start laden. Standardmaessig aus.
  auto_load: false

# =============================================================================
# Arbeitsablaeufe (Phase 19)
# =============================================================================
workflows:
  enabled: true
  max_steps: 25

# =============================================================================
# Bildverstehen (Phase 9/16)
# =============================================================================
vision:
  enabled: true
  # Bildschirmbilder an das Sprachmodell uebertragen duerfen. Auf false
  # bleibt alles lokal; der Text laesst sich trotzdem auslesen.
  allow_image_to_model: true
  # Aufnahmen nach der Auswertung behalten. Standardmaessig aus.
  keep_after_analysis: false
  # Nach wie vielen Minuten eine Aufnahme geloescht wird.
  keep_minutes: 10
  # Laengste Bildkante. Groessere Aufnahmen werden verkleinert.
  max_edge: 1600
  # Sprachen fuer die Texterkennung.
  ocr_languages: "deu+eng"

# =============================================================================
# Antwortpipeline (Phase 17)
# =============================================================================
pipeline:
  timeout_seconds: 180
  retries_per_stage: 1
  minimum_answer_characters: 1
  last_resort_message: >-
    Ich kann gerade nicht antworten. Das Sprachmodell ist nicht erreichbar -
    pruefe die Internetverbindung oder starte AI-Orb neu. Die Einzelheiten
    stehen im Protokoll.

# =============================================================================
# Lernen aus der Nutzung (Phase 12)
# =============================================================================
learning:
  enabled: true

  # Der grosse Lehrplan: Personen und Gebiete des Denkens.
  #
  # Auftrag vom 18.08.2026: Philosophie, Mathematik, Geschichtswissenschaft,
  # Quantenphysik, Physik, Chemie, Biologie, Religionen, Sprachwissenschaft -
  # und die Personen dahinter, von Sokrates bis Harari. Rund 240 Themen mit
  # etwa 970 Fragen. Jede Person wird ein eigenes Thema, damit sich spaeter
  # gezielt fragen laesst ("was weisst du ueber Emmy Noether").
  grosser_lehrplan: true

  # In welchem Takt der Orb im Leerlauf eine offene Frage abarbeitet.
  #
  # Getrennt vom Wartungstakt, seit der grosse Lehrplan dazukam: Bei einer
  # Frage je halber Stunde waere er erst in drei Wochen durch. Sieben
  # Minuten ergeben rund 200 Fragen am Tag - der ganze Plan also in gut
  # fuenf Tagen Leerlauf. Kleiner setzen heisst schneller lernen und mehr
  # Netzverkehr; er arbeitet ohnehin nur, wenn gerade nichts zu tun ist.
  takt_sekunden: 420

  # Ob der Orb an offenen Fragen weiterarbeitet, wenn gerade nichts zu tun ist.
  #
  # Er nimmt sich dabei je Durchgang GENAU EINE Frage vor, und zwar aus dem
  # Thema, an dem am laengsten nicht gearbeitet wurde. Nicht aus Sparsamkeit:
  # Eine Recherche, die sich selbst weitertreibt, ergibt nach einer Nacht ein
  # Thema mit dreihundert Aussagen, die niemand mehr durchsieht.
  #
  # Er sagt dabei nichts von sich aus. Das Ergebnis steht im Protokoll und im
  # Ereigniskanal - wer wissen will, was dazugekommen ist, fragt "was weisst
  # du ueber X". Ein Assistent, der unaufgefordert zu reden beginnt, weil er
  # gerade etwas gelesen hat, waere eine Zumutung.
  #
  # Auf false arbeitet er nur, wenn du ihn darum bittest.
  autonomous: true

  # Ob der Lehrplan beim Start angelegt wird.
  #
  # Er traegt Fragen zu Geschichtswissenschaft, den Epochen von der Antike
  # bis zur Neuesten Geschichte, globaler Politik und globalen Konflikten
  # ein - siehe backend/learning/lehrplan.py. Der Orb arbeitet sie mit der
  # Zeit ab, eine je Wartungsdurchgang.
  #
  # Bestehende Themen werden dabei ERGAENZT und nie ueberschrieben: Was du
  # ihm selbst erklaert hast, bleibt stehen.
  curriculum: true

  # Ab wie vielen Beobachtungen eine Vorliebe als belegt gilt.
  minimum_observations: 8

# =============================================================================
# Wissensbasis (Phase 7/11)
# =============================================================================
knowledge:
  enabled: true
  # Zeichen je Abschnitt beim Zerlegen eines Dokuments.
  passage_characters: 900
  max_document_mb: 10
  # Ab welcher Aehnlichkeit ein Abschnitt als Treffer gilt.
  minimum_score: 0.06

# =============================================================================
# Praesenz und Persoenlichkeit (Phase 8/14)
# =============================================================================
presence:
  # Grundstimmung, zu der der Orb zurueckkehrt.
  baseline_valence: 0.15
  baseline_arousal: 0.3
  # Wie stark Ereignisse auf die Stimmung wirken. 0 schaltet sie ab.
  emotion_intensity: 1.0
  # Ruhezeit: gedaempft, keine Hinweise von sich aus.
  quiet_hours: [22, 7]
  night_brightness: 0.55
  # Nach wie vielen Stunden ohne Kontakt wieder begruesst wird.
  greeting_gap_hours: 6
  # Von sich aus sprechen duerfen. Standardmaessig aus.
  proactive_enabled: false
  proactive_gap_minutes: 45

personality:
  name: "AI-Orb"
  # Alle Werte von 0.0 bis 1.0. Mittlere Werte wirken sich nicht aus -
  # nur deutliche Auspraegungen aendern den Ton.
  waerme: 0.6
  ausfuehrlichkeit: 0.4
  foermlichkeit: 0.3
  humor: 0.7
  eigeninitiative: 0.4
  vorsicht: 0.7

# =============================================================================
# Launcher und Installation (Phasen 45, 52, 55, 58, 59)
# =============================================================================
# Diese Einstellungen betreffen den Start der installierten Fassung. Im
# Quellbetrieb wirken die meisten davon nicht.
launcher:
  # Beim Start jeden Dienst pruefen und den Bericht ins Protokoll schreiben.
  health_check: true

  # Abstand der Ueberwachungspruefungen in Sekunden. Kleinere Werte erkennen
  # einen Ausfall frueher und kosten etwas mehr Leerlauf.
  supervision_interval: 5

  # Wie oft ein ausgefallener Dienst hoechstens neu gestartet wird.
  # Danach wird aufgegeben und im Klartext gesagt, was fehlt.
  max_restarts: 3

  # Ladebildschirm waehrend des Starts zeigen.
  splash_screen: true

  # Ollama beim Start mitstarten, falls es installiert ist.
  start_ollama: true

  # Das Offline-Modell ungefragt herunterladen. Standardmaessig aus:
  # lfm2.5:8b sind rund fuenf Gigabyte, und die laedt man nicht nebenbei.
  download_offline_model: false

# =============================================================================
# Aktualisierung (Phase 56)
# =============================================================================
update:
  # Beim Start nach einer neuen Fassung sehen. Es wird nichts installiert,
  # nur gemeldet.
  check_on_start: false

  # Ein Update fasst diese Dinge niemals an - unabhaengig von allem anderen.
  # Die Liste steht hier, damit sie nachlesbar ist, nicht damit sie
  # geaendert wird.
  never_touch:
    - "Gedaechtnis"
    - "Benutzereinstellungen"
    - "Projekte"
    - "Wissensnetz"
    - "Positionsdaten"
    - "Zugangsdaten"

# =============================================================================
# Studium: das Aktuellhalten der Wissenslandkarte
# =============================================================================
studium:
  # Ob der Orb seine Themen im Hintergrund auf dem Stand der Forschung
  # haelt. Er fragt dafuer OpenAlex und Crossref - offene Kataloge ohne
  # Schluessel, fuer den programmatischen Zugriff gebaut.
  aktualisierung: true

  # Ein Thema je Takt, die beruehrten zuerst. Eine halbe Stunde heisst:
  # Jedes der 45 Themen kommt etwa alle zehn Tage an die Reihe - und
  # zwei Anfragen je halbe Stunde sind hoeflich gegenueber den Quellen.
  aktualisierung_takt_sekunden: 1800

  # Erst nach dieser Zeit wird ein Thema erneut geprueft. Wissenschaft
  # erscheint nicht im Stundentakt.
  aktualisierung_abstand_tage: 7
